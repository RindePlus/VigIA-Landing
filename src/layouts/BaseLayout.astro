---
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.jsx';
import { getImage } from 'astro:assets';
import logoClaro from '../assets/vigia-biostres-logo-light.png';
import logoOscuro from '../assets/vigia-biostres-logo-dark.png';
import { IDIOMAS, alternativas, conBarra, contenido, idiomaDe, ruta } from '../i18n/idiomas';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showMenu?: boolean;
  /** Datos estructurados (schema.org) de la página, si los tiene. */
  jsonLd?: Record<string, unknown>;
  /** Fuera de los buscadores: el 404 y las páginas todavía sin contenido.
   *  Va sin canonical ni hreflang, que contradirían el noindex. */
  noindex?: boolean;
}

// Idioma de la página (ADR 0004 y ADR 0008): sale de la ruta (/en/… =
// inglés, /pt/… = portugués).
const lang = idiomaDe(Astro.currentLocale);
const idioma = IDIOMAS.find((i) => i.code === lang) ?? IDIOMAS[0];
const otrosIdiomas = IDIOMAS.filter((i) => i.code !== lang);
const { MARCA, SEO, UI, WHATSAPP_URL } = contenido(lang);
// Logo del header (50 px de alto), en WebP y al doble para pantallas de alta
// densidad: el PNG original (398 × 324) pesaba 61 KB. El header es una isla
// React y no puede usar <Image>, así que se le pasan las URLs.
const LOGO_ALTO = 50;
const [logoHeaderClaro, logoHeaderOscuro] = await Promise.all(
  [logoClaro, logoOscuro].map((src) => getImage({ src, height: LOGO_ALTO * 2, format: 'webp' })),
);
const logos = {
  claro: logoHeaderClaro.src,
  oscuro: logoHeaderOscuro.src,
  ancho: Math.round((logoClaro.width / logoClaro.height) * LOGO_ALTO),
  alto: LOGO_ALTO,
};
// Rutas de esta misma página en cada idioma (para el selector y hreflang).
const alt = alternativas(Astro.url.pathname);

const { title = SEO.titulo, description = SEO.descripcion, showMenu = true, jsonLd, noindex = false } = Astro.props;

// Las etiquetas para redes necesitan URLs absolutas. `site` se define en
// astro.config.mjs; mientras no esté, se usa el dominio del producto.
const site = Astro.site ?? new URL('https://vigiabioestres.com');
const pageUrl = new URL(conBarra(Astro.url.pathname), site).href;
const ogImage = new URL('/og.jpg', site).href;
// hreflang: sólo si la página existe traducida (las legales no) y se
// indexa.
const hreflang = alt.traducida && !noindex
  ? [
      { lang: 'es', href: new URL(alt.es, site).href },
      { lang: 'en', href: new URL(alt.en, site).href },
      { lang: 'pt', href: new URL(alt.pt, site).href },
      { lang: 'x-default', href: new URL(alt.es, site).href },
    ]
  : [];
---

<!doctype html>
<html lang={idioma.html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={idioma.og} />
    {hreflang.length > 0 && otrosIdiomas.map((i) => <meta property="og:locale:alternate" content={i.og} />)}
    <meta property="og:site_name" content={MARCA} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Fuente del texto, alojada en el sitio (@font-face en global.css):
         se precarga para que el primer texto ya salga con ella. -->
    <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Resuelve el tema antes del primer paint para evitar el flash claro→oscuro.
         Misma clave y criterio que src/hooks/useTheme.js. -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('vg-theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-rp-theme', theme);
        // Habilita las apariciones al hacer scroll sólo con JS y movimiento
        // permitido; sin esta clase el contenido se ve de entrada.
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('vg-reveal-on');
        }
        // Llegada con una sección en la URL (/#impacto, desde otra página):
        // sin scroll suave, así el navegador no recorre la página desde
        // arriba. Lo vuelve a activar el script de llegada, al final.
        if (location.hash) document.documentElement.style.scrollBehavior = 'auto';
      })();
    </script>
  </head>
  <body class="rp-home">
    <a class="vg-skip" href="#contenido">{UI.saltar}</a>
    <Header
      client:load
      showMenu={showMenu}
      lang={lang}
      menuItems={UI.menu}
      textos={UI.header}
      inicioHref={ruta(lang, '/')}
      inicioLabel={`${MARCA} — ${UI.inicio}`}
      whatsappUrl={WHATSAPP_URL}
      rutas={{ es: alt.es, en: alt.en, pt: alt.pt }}
      logos={logos}
    />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppWidget client:idle textos={UI.widget} whatsappUrl={WHATSAPP_URL} />

    <!-- Cambio de idioma: el selector del header guarda en qué sección y a
         qué altura de ella estaba el usuario; acá, en la página del otro
         idioma, se vuelve a ese punto (los textos miden distinto, así que se
         usa la proporción dentro de la sección, no los píxeles). Lo que ya
         queda a la vista se muestra sin la animación de aparición, para que
         el cambio sea sólo el fundido de la transición. Inline: corre antes
         del primer paint y antes del observer de abajo. -->
    <script is:inline>
      (function () {
        var dato = null;
        try {
          dato = JSON.parse(sessionStorage.getItem('vg-idioma-scroll') || 'null');
          sessionStorage.removeItem('vg-idioma-scroll');
        } catch (e) {}
        var limpiar = function (r) { return r.replace(/\/+$/, '') || '/'; };
        if (!dato || limpiar(dato.destino) !== limpiar(location.pathname) || location.hash) return;
        var el = dato.id && document.getElementById(dato.id);
        if (!el) return;
        var r = el.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + r.top + r.height * dato.proporcion, behavior: 'instant' });
        var alto = window.innerHeight;
        document.querySelectorAll('[data-reveal]').forEach(function (n) {
          var b = n.getBoundingClientRect();
          if (b.top < alto && b.bottom > -alto * 0.1) n.removeAttribute('data-reveal');
        });
      })();
    </script>

    <!-- Llegada desde otra página a una sección (/#impacto): va directo a
         ella, sin recorrer la página. Antes de que el header de React mida su
         alto, se toma del HTML, así la sección cae justo debajo de él. Al
         terminar de cargar (tipografías, el alto fijo de Impacto) la vuelve a
         alinear, salvo que la persona ya haya movido el scroll. Lo que queda
         a la vista se muestra sin la animación de aparición. El header queda
         visible durante la llegada (Header.jsx). -->
    <script is:inline>
      (function () {
        var id = decodeURIComponent(location.hash.slice(1));
        var destino = id && document.getElementById(id);
        var raiz = document.documentElement;
        if (!destino) { raiz.style.scrollBehavior = ''; return; }
        var header = document.querySelector('header');
        if (header) raiz.style.setProperty('--alto-header', header.offsetHeight + 'px');
        var movio = false;
        var marcar = function () { movio = true; };
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (t) {
          window.addEventListener(t, marcar, { once: true, passive: true });
        });
        var ir = function () { if (!movio) destino.scrollIntoView({ block: 'start', behavior: 'instant' }); };
        ir();
        var alto = window.innerHeight;
        document.querySelectorAll('[data-reveal]').forEach(function (n) {
          var b = n.getBoundingClientRect();
          if (b.top < alto && b.bottom > -alto * 0.1) n.removeAttribute('data-reveal');
        });
        var listo = function () {
          ir();
          // Una vuelta más: el alto de Impacto y el hilo se miden al cargar.
          requestAnimationFrame(function () { ir(); raiz.style.scrollBehavior = ''; });
        };
        if (document.readyState === 'complete') listo();
        else window.addEventListener('load', function () {
          (document.fonts ? document.fonts.ready : Promise.resolve()).then(listo);
        });
      })();
    </script>

    <!-- Apariciones al hacer scroll ([data-reveal], estilos en global.css).
         IntersectionObserver en lugar de un listener de scroll: no fuerza
         reflows y cada elemento se anima una sola vez. -->
    <script>
      const root = document.documentElement;
      if (root.classList.contains('vg-reveal-on')) {
        // En celular se dispara apenas el elemento asoma: al bajar rápido no
        // quedan huecos esperando a que el contenido aparezca.
        const celular = window.matchMedia('(max-width: 680px)').matches;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-revealed');
              observer.unobserve(el);
              // Terminada la aparición se quita el atributo para que el
              // elemento recupere sus propias transiciones (hover sin retraso).
              const done = (event: TransitionEvent) => {
                if (event.target !== el || event.propertyName !== 'opacity') return;
                el.removeEventListener('transitionend', done);
                el.removeAttribute('data-reveal');
                el.classList.remove('is-revealed');
              };
              el.addEventListener('transitionend', done);
            });
          },
          celular ? { rootMargin: '0px', threshold: 0 } : { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
