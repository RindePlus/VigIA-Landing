---
// Home de VigIA BioEstrés (versión 2 de doc/landing/ESTRUCTURA_LANDING.md):
// Hero (con los clientes) → El problema → Lo que hace VigIA → La solución
// (recorrido del mismo lote) → Frase destacada → Resultados → Sobre nosotros →
// Preguntas (con el CTA de cierre). Scroll normal en todas las pantallas
// (ADR 0007); sólo el hero ocupa una pantalla (ADR 0009).
// Una sola home para los tres idiomas (ADR 0004 y ADR 0008):
// src/pages/index.astro la usa en español, src/pages/en/index.astro en inglés
// y src/pages/pt/index.astro en portugués. El contenido sale de
// src/data/vigia.js, vigia.en.js o vigia.pt.js según el idioma. Los medios de las tres
// primeras secciones usan MediaStory: animación en código y, si hay, el
// video (src/data/videos.js).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BalanceChart from '../components/BalanceChart.astro';
import WhatsAppMock from '../components/WhatsAppMock.astro';
import ProblemChart from '../components/ProblemChart.astro';
import MediaStory from '../components/MediaStory.astro';
import FieldRows from '../components/FieldRows.astro';
import LotesConexion from '../components/LotesConexion.astro';
import Pivotes from '../components/Pivotes.astro';
import JourneyThread from '../components/JourneyThread.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import TrustedCompanies from '../components/TrustedCompanies.jsx';
import {
  PiWhatsappLogo,
  PiPlant,
  PiCloudSun,
  PiMonitor,
  PiCaretDown,
  PiArrowRight,
  PiX,
} from 'react-icons/pi';
import { IDIOMAS, contenido, idiomaDe } from '../i18n/idiomas';
import { CONTACT_EMAIL, OFFICE_ADDRESS, WHATSAPP_DISPLAY, buildWhatsAppUrl } from '../data/social';
import { EQUIPO } from '../data/equipo';
import { VIDEOS, DESCRIPCION_PENDIENTE } from '../data/videos';
import '../styles/sections.css';

const lang = idiomaDe(Astro.currentLocale);
const {
  CTA,
  MARCA,
  SEO,
  HERO,
  PROBLEMA,
  QUE_HACE,
  COMO_FUNCIONA,
  FRASE,
  IMPACTO,
  NOSOTROS,
  CLIENTES,
  PREGUNTAS,
  UI,
} = contenido(lang);
// Videos con el rótulo de capítulo en el idioma de la página.
const videoProblema = { ...VIDEOS.problema, rotulo: UI.videos.problema };
const videoResolucion = { ...VIDEOS.resolucion, rotulo: UI.videos.resolucion };

const ICONOS_RAZONES = { sintoma: PiPlant, pronostico: PiCloudSun };
const ICONOS_CANALES = { plataforma: PiMonitor, whatsapp: PiWhatsappLogo };
// Escalonado de las apariciones al hacer scroll ([data-reveal], global.css).
// Sólo aparecen los grupos de contenido; títulos, bajadas y el hero están
// de entrada (decisión 49).
const delay = (i: number) => `--reveal-delay: ${i * 100}ms`;
// Cifras en tipografía de datos (monoespaciada): el separador de miles y el
// decimal van en la tipografía normal, que es angosta; en mono ocupan el
// ancho de un dígito y la cifra se lee partida ("20 . 000").
const partes = (v: string) => v.split(/([.,])/).map((t) => ({ t, sep: t === '.' || t === ',' }));
const ctaUrl = buildWhatsAppUrl(CTA.mensajeWhatsApp);
// Indicadores de Impacto que abren una tabla (los paneles, de a uno).
const CON_TABLA = IMPACTO.indicadores.flatMap((ind) => (ind.tabla ? [{ id: ind.id, tabla: ind.tabla }] : []));

// Datos estructurados para buscadores: la organización, el sitio (en el
// idioma de la página) y las preguntas frecuentes. Sin redes (sameAs):
// todavía son las de Rinde Plus (src/data/social.js).
const sitio = (Astro.site ?? new URL('https://vigiabioestres.com')).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${sitio}#organizacion`,
      name: MARCA,
      url: sitio,
      logo: new URL('/marca/vigia-biostres-logo.png', sitio).href,
      email: CONTACT_EMAIL,
      telephone: WHATSAPP_DISPLAY,
      address: { '@type': 'PostalAddress', streetAddress: OFFICE_ADDRESS, addressCountry: 'AR' },
    },
    {
      '@type': 'WebSite',
      '@id': `${sitio}#sitio`,
      name: MARCA,
      url: sitio,
      inLanguage: IDIOMAS.map((i) => i.html),
      publisher: { '@id': `${sitio}#organizacion` },
    },
    {
      '@type': 'FAQPage',
      inLanguage: IDIOMAS.find((i) => i.code === lang)?.html,
      mainEntity: PREGUNTAS.items.map((p) => ({
        '@type': 'Question',
        name: p.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
      })),
    },
  ],
};
---

<BaseLayout title={SEO.titulo} description={SEO.descripcion} jsonLd={jsonLd}>
  <!-- Las cuatro primeras secciones comparten un fondo que cambia con la
       historia del lote y un hilo que las conecta (JourneyThread). -->
  <div class="vg-journey">
  <JourneyThread />

  <!-- 1. Hero -->
  <section class="vg-hero vg-pantalla" id="inicio">
    <FieldRows />
    <div class="vg-wrap vg-hero__grid">
      <div class="vg-hero__copy">
        <h1 class="vg-hero__title" data-vg-node="1">{HERO.titulo}</h1>
        <p class="vg-hero__subtitle">{HERO.bajada}</p>
        <!-- CTA en la columna de texto, debajo de la bajada (decisión 47). -->
        <div class="vg-hero__ctas">
          <a class="vg-btn vg-btn--cta" href={ctaUrl} target="_blank" rel="noopener noreferrer">
            {CTA.texto}
            <PiArrowRight aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="vg-media">
        <!-- 11 s: la animación dura ~3,5 s y el final queda quieto el resto,
             para que se pueda leer antes de reiniciar. -->
        <MediaStory duracion={11000}>
          <BalanceChart />
        </MediaStory>
      </div>
    </div>
    <!-- Clientes al pie del hero, en la misma pantalla (decisión 59): fuera
         del .vg-wrap, el carrusel ocupa todo el ancho. Sin título a la vista
         ("Confían en nosotros" queda como nombre accesible). El hilo pasa
         por debajo, como por un túnel: entra en un semicírculo (∪) y sale por otro (∩)
         (data-vg-under, JourneyThread.astro). -->
    <div class="vg-trusted" id="clientes" role="region" aria-label={CLIENTES.titulo} data-vg-under>
      <TrustedCompanies client:idle />
    </div>
  </section>

  <!-- 2. El problema -->
  <section class="vg-section" id="problema">
    <LotesConexion />
    <div class="vg-wrap">
      <!-- Título, bajada y razones en la columna izquierda: el gráfico queda
           centrado a la derecha, entre el título y las razones. -->
      <div class="vg-problema">
        <div class="vg-problema__texto">
          <h2 class="vg-section__title" data-vg-node="2">{PROBLEMA.titulo}</h2>
          <p class="vg-section__lead">{PROBLEMA.bajada}</p>
          <ul class="vg-razones">
            {
              PROBLEMA.razones.map((r, i) => {
                const Icon = ICONOS_RAZONES[r.id as keyof typeof ICONOS_RAZONES];
                return (
                  <li class="vg-razon" data-reveal style={delay(i)}>
                    <span class="vg-razon__icon" aria-hidden="true"><Icon /></span>
                    <div>
                      <h3>{r.titulo}</h3>
                      <p>{r.texto}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-media" data-reveal style={delay(1)}>
          <!-- 11 s: la animación dura ~4,6 s y el final queda quieto el resto,
               para que se pueda leer antes de pasar al video. -->
          <MediaStory duracion={11000} video={videoProblema} pendiente={DESCRIPCION_PENDIENTE.problema}>
            <ProblemChart />
          </MediaStory>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Lo que hace VigIA: cuatro tarjetas con foto, que también cuentan
       las cuatro alertas y su acción. Punto 3 del hilo, en celeste. -->
  <section class="vg-section vg-solucion" id="que-hace">
    <Pivotes borde="fin" />
    <div class="vg-wrap">
      <h2 class="vg-section__title" data-vg-node="3">{QUE_HACE.titulo}</h2>
      <p class="vg-section__lead">{QUE_HACE.bajada}</p>

      <!-- Cuatro tarjetas: la foto ocupa toda la tarjeta y el título y el
           texto van abajo, sobre una franja con desenfoque. -->
      <ul class="vg-puntos">
        {
          QUE_HACE.puntos.map((pt, i) => (
            <li class="vg-punto" data-reveal style={delay(i)}>
              <Image
                class="vg-punto__img"
                src={pt.imagen}
                alt={pt.alt}
                widths={[480, 800]}
                sizes="480px"
                loading="lazy"
                decoding="async"
              />
              <div class="vg-punto__texto">
                <h3>{pt.titulo}</h3>
                <p>{pt.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Otros módulos, con enlace a su página: debajo de las tarjetas,
           en dos columnas. -->
      <ul class="vg-modulos">
        {
          QUE_HACE.modulos.map((m, i) => (
            <li class="vg-modulo" data-reveal style={delay(i)}>
              <p>
                <strong>{m.pregunta}</strong> {m.texto}
              </p>
              {m.enlace.href && (
                <a class="vg-modulo__link" href={m.enlace.href} target="_blank" rel="noopener noreferrer">
                  {m.enlace.texto}
                  <PiArrowRight aria-hidden="true" />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. La solución (ancla #como-funciona, la del menú): los dos canales de
       la alerta son lo principal -->
  <section class="vg-section" id="como-funciona">
    <Pivotes />
    <div class="vg-wrap">
      <!-- Título, bajada y canales a la izquierda; el WhatsApp con el video a
           la derecha, terminando a la altura de la tarjeta de la plataforma. -->
      <div class="vg-avisos">
        <div class="vg-avisos__texto">
          <h2 class="vg-section__title" data-vg-node="4">{COMO_FUNCIONA.titulo}</h2>
          <p class="vg-section__lead">{COMO_FUNCIONA.bajada}</p>
          <ul class="vg-canales">
            {
              COMO_FUNCIONA.canales.map((c, i) => {
                const Icon = ICONOS_CANALES[c.id as keyof typeof ICONOS_CANALES];
                return (
                  <li class={`vg-canal vg-canal--${c.id}`} data-reveal style={delay(i)}>
                    <span class="vg-canal__icon" aria-hidden="true"><Icon /></span>
                    <div>
                      <h3>{c.titulo}</h3>
                      <p>{c.texto}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-media" data-reveal style={delay(1)}>
          <MediaStory duracion={4500} cierre={3200} video={videoResolucion} pendiente={DESCRIPCION_PENDIENTE.resolucion}>
            <WhatsAppMock />
          </MediaStory>
        </div>
      </div>

      <!-- Cómo lo hace: debajo de las dos columnas, tres pasos en fila (en
           celular, uno debajo del otro) unidos por una línea. Es el ancla
           final del hilo (data-vg-end): no lleva data-reveal. -->
      <div class="vg-detalle" data-vg-end>
        <h3 class="vg-detalle__label">{COMO_FUNCIONA.tituloPasos}</h3>
        <!-- Línea de tiempo: un punto por paso; la línea se dibuja de un
             punto al siguiente y cada paso aparece cuando la línea llega a él
             (estilos en sections.css, .vg-pasos). -->
        <ol class="vg-pasos" data-reveal>
          {
            COMO_FUNCIONA.pasos.map((p, i) => (
              <li class="vg-paso" style={`--i: ${i}`}>
                <p class="vg-paso__titulo">{p.titulo}</p>
                <p class="vg-paso__texto">{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  </div>

  <!-- 5. Frase destacada -->
  <TaglineReveal lineas={FRASE} />

  <!-- 6. Impacto: cuatro indicadores grandes con una línea corta debajo.
       Los dos últimos son botones que abren su tabla en un panel centrado
       debajo, de a uno; una flecha en el borde del panel apunta al indicador
       del que salió (script al final de la sección). -->
  <section class="vg-section vg-section--compact vg-impacto vg-pantalla" id="impacto" data-fondo-oscuro>
    <div class="vg-wrap">
      <!-- En pantallas horizontales (ADR 0009),
           con una tabla abierta el título y la bajada se pliegan, los
           indicadores suben y la tabla entra en la pantalla (.is-tabla). -->
      <div class="vg-impacto__cabeza">
        <div>
          <h2 class="vg-section__title">{IMPACTO.titulo}</h2>
          <p class="vg-section__lead">{IMPACTO.bajada}</p>
        </div>
      </div>

      <div class="vg-indicadores-box">
        <ul class="vg-indicadores">
          {
            IMPACTO.indicadores.map((ind, i) => (
              <li data-reveal style={delay(i)}>
                {
                  ind.tabla ? (
                    <button
                      type="button"
                      class={`vg-indicador vg-indicador--boton vg-indicador--${ind.id}`}
                      aria-expanded="false"
                      aria-controls={`vg-panel-${ind.id}`}
                      data-panel={ind.id}
                    >
                      <strong>{partes(ind.valor).map((p) => (p.sep ? <span class="vg-sep">{p.t}</span> : p.t))}<small>{ind.unidad}</small></strong>
                      <span>{ind.texto}</span>
                      <PiCaretDown className="vg-indicador__caret" aria-hidden="true" />
                    </button>
                  ) : (
                    <div class="vg-indicador">
                      <strong>{partes(ind.valor).map((p) => (p.sep ? <span class="vg-sep">{p.t}</span> : p.t))}<small>{ind.unidad}</small></strong>
                      <span>{ind.texto}</span>
                    </div>
                  )
                }
              </li>
            ))
          }
        </ul>
        <!-- Aviso de una sola vez: aparece al entrar la sección y se va solo. -->
        <p class="vg-indicadores__pista" aria-hidden="true" data-pista>{IMPACTO.pista}</p>
      </div>

      <div class="vg-panel" data-panel-box>
        <div class="vg-panel__inner">
          <span class="vg-panel__flecha" aria-hidden="true"></span>
          <!-- Las tablas ocupan la misma celda: al cambiar, una sale hacia un
               lado y la otra entra desde el otro (como la flecha). -->
          <div class="vg-panel__items">
            {
              CON_TABLA.map((ind) => (
                <div
                  class={`vg-panel__item vg-panel__item--${ind.id}`}
                  id={`vg-panel-${ind.id}`}
                  role="region"
                  aria-label={ind.tabla.titulo}
                  data-pos="despues"
                  inert
                >
                  <div class="vg-panel__head">
                    <h3>{ind.tabla.titulo}</h3>
                    <button type="button" class="vg-panel__cerrar" aria-label={IMPACTO.cerrar} data-panel-cerrar>
                      <PiX aria-hidden="true" />
                    </button>
                  </div>
                  <div class="vg-tabla">
                    <table>
                      <thead>
                        <tr>{ind.tabla.columnas.map((c) => <th scope="col">{c}</th>)}</tr>
                      </thead>
                      <tbody>
                        {
                          ind.tabla.filas.map((f, j) => (
                            <tr class={j === ind.tabla.filas.length - 1 ? 'vg-tabla__total' : undefined}>
                              <th scope="row">{f[0]}</th>
                              {f.slice(1).map((v) => <td>{partes(v).map((p) => (p.sep ? <span class="vg-sep">{p.t}</span> : p.t))}</td>)}
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                  </div>
                  <p class="vg-panel__nota">{ind.tabla.nota}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Panel de Impacto: un indicador abre su tabla y cierra la otra; el
    // mismo indicador, la cruz o Escape la cierran. La flecha se ubica bajo
    // el indicador de origen y, al cambiar de tabla, la flecha y el
    // contenido se deslizan juntos hacia el mismo lado.
    const seccion = document.querySelector<HTMLElement>('#impacto');
    const caja = seccion?.querySelector<HTMLElement>('[data-panel-box]');
    if (seccion && caja) {
      const botones = [...seccion.querySelectorAll<HTMLButtonElement>('[data-panel]')];
      const ids = botones.map((b) => b.dataset.panel ?? '');
      const items = ids.map((id) => document.getElementById(`vg-panel-${id}`));
      let abierto: string | null = null;

      const ubicarFlecha = () => {
        const boton = botones.find((b) => b.dataset.panel === abierto);
        if (!boton) return;
        const b = boton.getBoundingClientRect();
        const c = caja.getBoundingClientRect();
        caja.style.setProperty('--flecha-x', `${b.left + b.width / 2 - c.left}px`);
      };

      const mostrar = (id: string | null) => {
        const veniaCerrado = abierto === null;
        abierto = id;
        botones.forEach((b) => {
          const activo = b.dataset.panel === id;
          b.setAttribute('aria-expanded', String(activo));
          b.classList.toggle('is-active', activo);
        });
        cancelarPista();
        if (veniaCerrado !== (id === null)) {
          seccion.classList.toggle('is-tabla', id !== null);
        }

        if (id === null) {
          // Al cerrar, el panel se pliega con la tabla adentro.
          caja.classList.remove('is-open');
          items.forEach((el) => el && (el.inert = true));
          return;
        }

        // Si el panel estaba cerrado, la tabla y la flecha se ubican sin
        // deslizarse (sólo se despliega el panel).
        if (veniaCerrado) caja.classList.add('is-instant');
        const idx = ids.indexOf(id);
        items.forEach((el, i) => {
          if (!el) return;
          el.dataset.pos = i < idx ? 'antes' : i > idx ? 'despues' : 'activo';
          el.inert = i !== idx;
        });
        caja.dataset.tono = id;
        ubicarFlecha();
        caja.classList.add('is-open');
        if (veniaCerrado) {
          void caja.offsetWidth; // aplica las posiciones antes de volver a animar
          caja.classList.remove('is-instant');
        }
      };

      botones.forEach((b) =>
        b.addEventListener('click', () => mostrar(abierto === b.dataset.panel ? null : (b.dataset.panel ?? null))),
      );
      seccion.querySelectorAll('[data-panel-cerrar]').forEach((x) =>
        x.addEventListener('click', () => {
          const origen = botones.find((b) => b.dataset.panel === abierto);
          mostrar(null);
          origen?.focus();
        }),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && abierto) mostrar(null);
      });
      window.addEventListener('resize', ubicarFlecha, { passive: true });

      // Alto fijo de la sección en horizontal: el que ocupa con la tabla más
      // alta abierta (margen + indicadores + panel), para que al abrirla la
      // sección no crezca. Las dos tablas comparten la celda: el alto del
      // contenido del panel ya es el de la más alta.
      const indicadores = seccion.querySelector<HTMLElement>('.vg-indicadores-box');
      const interior = caja.querySelector<HTMLElement>('.vg-panel__inner');
      const medirAlto = () => {
        if (!indicadores || !interior) return;
        const estilo = getComputedStyle(seccion);
        const margen = parseFloat(estilo.paddingTop) + parseFloat(estilo.paddingBottom);
        const alto = margen + indicadores.offsetHeight + interior.scrollHeight;
        seccion.style.setProperty('--alto-impacto', `${Math.ceil(alto)}px`);
      };
      medirAlto();
      document.fonts?.ready.then(medirAlto);
      window.addEventListener('resize', medirAlto, { passive: true });

      // Aviso de una sola vez: aparece cuando los indicadores entran en
      // pantalla y se va a los pocos segundos (o al tocar un indicador).
      const pista = seccion.querySelector<HTMLElement>('[data-pista]');
      let temporizador = 0;
      function cancelarPista() {
        window.clearTimeout(temporizador);
        pista?.classList.remove('is-visible');
      }
      if (pista && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            if (!entradas.some((e) => e.isIntersecting)) return;
            io.disconnect();
            pista.classList.add('is-visible');
            temporizador = window.setTimeout(cancelarPista, 4000);
          },
          { threshold: 0.6 },
        );
        io.observe(seccion.querySelector('.vg-indicadores') ?? seccion);
      }
    }
  </script>

  <!-- 7. Sobre nosotros: foto, nombre y logo de la empresa de cada persona.
       Sin foto cargada, van las iniciales en el mismo círculo. -->
  <section class="vg-section vg-section--compact vg-nosotros" id="nosotros">
    <div class="vg-wrap">
      <h2 class="vg-section__title">{NOSOTROS.titulo}</h2>
      <p class="vg-section__lead">{NOSOTROS.bajada}</p>
      <ul class="vg-equipo">
        {
          EQUIPO.map((p, i) => (
            <li class="vg-persona" data-reveal style={delay(i)}>
              {
                p.foto ? (
                  <img
                    class="vg-persona__foto"
                    src={p.foto.src}
                    alt=""
                    width="88"
                    height="88"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="vg-persona__foto vg-persona__foto--iniciales" aria-hidden="true">
                    {p.nombre.split(' ').map((n) => n[0]).join('')}
                  </span>
                )
              }
              <h3>{p.nombre}</h3>
              <div class="vg-persona__empresa">
                <p class="vg-persona__rol">{NOSOTROS.representa}</p>
                <div class="vg-persona__logo">
                  <img
                    src={p.empresa.logo.src}
                    alt={p.empresa.nombre}
                    width={Math.round((p.empresa.logo.width / p.empresa.logo.height) * p.empresa.logoAlto)}
                    height={p.empresa.logoAlto}
                    style={`--logo-alto: ${p.empresa.logoAlto}px`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. Preguntas frecuentes, con el CTA de cierre debajo del título. -->
  <section class="vg-section vg-section--compact vg-preguntas" id="preguntas">
    <div class="vg-wrap vg-faq">
      <div class="vg-faq__head">
        <h2 class="vg-section__title">{PREGUNTAS.titulo}</h2>
      </div>
      <div class="vg-faq__list" data-reveal style={delay(1)}>
        {
          PREGUNTAS.items.map((p) => (
            <details class="vg-faq__item">
              <summary>
                <span>{p.pregunta}</span>
                <PiCaretDown className="vg-faq__caret" aria-hidden="true" />
              </summary>
              <p>{p.respuesta}</p>
            </details>
          ))
        }
      </div>
      <div class="vg-faq__cta">
        <p class="vg-faq__cierre">{PREGUNTAS.cierre}</p>
        <a class="vg-btn vg-btn--cta" href={ctaUrl} target="_blank" rel="noopener noreferrer">
          {CTA.texto}
          <PiArrowRight aria-hidden="true" />
        </a>
        {CTA.nota && <p class="vg-faq__nota">{CTA.nota}</p>}
      </div>
    </div>
  </section>

  <!-- Acordeón de preguntas: <details> abre y cierra de golpe, así que la
       altura se anima con la Web Animations API, con la curva y duración de
       los tokens. La respuesta además se funde. Con movimiento reducido o sin
       JS queda el comportamiento nativo. -->
  <script>
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const css = getComputedStyle(document.documentElement);
      const duration = parseFloat(css.getPropertyValue('--dur-slow')) || 700;
      const easing = css.getPropertyValue('--ease-fluid').trim() || 'ease-out';

      document.querySelectorAll<HTMLDetailsElement>('.vg-faq__item').forEach((item) => {
        const summary = item.querySelector('summary')!;
        const answer = item.querySelector('p');
        let anim: Animation | null = null;
        let closing = false;

        const run = (from: number, to: number, cerrar: boolean) => {
          item.style.overflow = 'hidden';
          anim = item.animate({ height: [`${from}px`, `${to}px`] }, { duration, easing });
          answer?.animate({ opacity: cerrar ? [1, 0] : [0, 1] }, { duration, easing, fill: 'forwards' });
          closing = cerrar;
          // Para que la flecha gire al empezar a cerrar, no al terminar.
          item.classList.toggle('is-closing', cerrar);
          anim.onfinish = () => {
            if (cerrar) item.open = false;
            closing = false;
            item.classList.remove('is-closing');
            anim = null;
            item.style.overflow = '';
            answer?.getAnimations().forEach((a) => a.cancel());
          };
        };

        summary.addEventListener('click', (event) => {
          event.preventDefault();
          // Altura actual (a mitad de una animación, la del momento).
          const from = item.offsetHeight;
          anim?.cancel();
          if (closing || !item.open) {
            item.open = true;
            run(from, item.offsetHeight, false);
          } else {
            const borde = item.offsetHeight - item.clientHeight;
            run(from, summary.offsetHeight + borde, true);
          }
        });
      });
    }
  </script>
</BaseLayout>
