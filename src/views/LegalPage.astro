---
// Política de privacidad del sitio, compartida por los tres idiomas:
// título, fecha de actualización y secciones (párrafos, una lista opcional y
// párrafos de cierre). El idioma sale de la ruta; los textos, de
// src/data/legal.js, legal.en.js o legal.pt.js (mismas claves). Se importan
// acá y no en src/i18n/idiomas.js: ese archivo también lo usa el header, que
// es una isla React, y los textos legales no tienen que llegar a su bundle.
// Los textos traen HTML propio (negritas y enlaces): van con set:html, sólo
// con texto fijo de esos archivos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contenido, idiomaDe } from '../i18n/idiomas';
import { PRIVACIDAD as privacidadEs } from '../data/legal.js';
import { PRIVACIDAD as privacidadEn } from '../data/legal.en.js';
import { PRIVACIDAD as privacidadPt } from '../data/legal.pt.js';
import '../styles/sections.css';

const lang = idiomaDe(Astro.currentLocale);
const { MARCA } = contenido(lang);
const texto = lang === 'en' ? privacidadEn : lang === 'pt' ? privacidadPt : privacidadEs;
---

<BaseLayout title={`${texto.titulo} · ${MARCA}`} description={texto.descripcion}>
  <section class="vg-section vg-legal">
    <div class="vg-wrap">
      <h1 class="vg-legal__titulo">{texto.titulo}</h1>
      <p class="vg-legal__fecha">{texto.fechaLabel}: {texto.actualizado}</p>
      {
        texto.secciones.map((s) => (
          <section class="vg-legal__seccion">
            <h2>{s.titulo}</h2>
            {s.parrafos.map((p) => <p set:html={p} />)}
            {s.lista && (
              <ul>
                {s.lista.map((item) => <li set:html={item} />)}
              </ul>
            )}
            {s.cierre?.map((p) => <p set:html={p} />)}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
