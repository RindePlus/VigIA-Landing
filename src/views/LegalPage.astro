---
// Página legal (privacidad, términos), compartida por los tres idiomas:
// título, fecha de actualización y secciones de texto corrido. El idioma
// sale de la ruta; los textos, de src/data/legal.js, legal.en.js o
// legal.pt.js (mismas claves). Se importan acá y no en src/i18n/idiomas.js:
// ese archivo también lo usa el header, que es una isla React, y los textos
// legales no tienen que llegar a su bundle.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contenido, idiomaDe } from '../i18n/idiomas';
import * as legalEs from '../data/legal.js';
import * as legalEn from '../data/legal.en.js';
import * as legalPt from '../data/legal.pt.js';
import '../styles/sections.css';

interface Props {
  pagina: 'privacidad' | 'terminos';
}

const lang = idiomaDe(Astro.currentLocale);
const { MARCA } = contenido(lang);
const { LEGAL_UI, PRIVACIDAD, TERMINOS } = lang === 'en' ? legalEn : lang === 'pt' ? legalPt : legalEs;
const texto = Astro.props.pagina === 'privacidad' ? PRIVACIDAD : TERMINOS;
---

<BaseLayout title={`${texto.titulo} · ${MARCA}`} description={texto.descripcion}>
  <section class="vg-section vg-legal">
    <div class="vg-wrap">
      <h1 class="vg-legal__titulo">{texto.titulo}</h1>
      <p class="vg-legal__fecha">{LEGAL_UI.actualizado}: {LEGAL_UI.fecha}</p>
      {
        texto.secciones.map((s) => (
          <section class="vg-legal__seccion">
            <h2>{s.titulo}</h2>
            {s.parrafos.map((p) => <p>{p}</p>)}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
