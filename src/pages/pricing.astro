---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildWhatsAppUrl } from '../data/social';
import '../styles/sections.css';

// TODO: definir el modelo de precios propio de VigIA (en Landing vive en
// src/data/pricing.js con tramos por CUIT).
const consultaUrl = buildWhatsAppUrl('Hola, quiero conocer los precios de VigIA');
---

<BaseLayout title="Precios · VigIA">
  <section class="vg-section vg-hero">
    <h1 class="vg-hero__title">Precios</h1>
    <p class="vg-hero__subtitle">Estamos definiendo los planes de VigIA. Escribinos y te contamos.</p>
    <a class="vg-btn" href={consultaUrl} target="_blank" rel="noopener noreferrer">Consultar</a>
  </section>
</BaseLayout>
