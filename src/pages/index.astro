---
// Home en tres módulos: Introducción → Qué problema resuelve → La mejora
// real, más para quién es, clientes y CTA. Contenido en src/data/vigia.js;
// estructura acordada en ESTRUCTURA_LANDING.md.
// Los medios de los tres módulos usan MediaStory: animación en código y,
// cuando exista, el video del módulo (src/data/videos.js).
import BaseLayout from '../layouts/BaseLayout.astro';
import BalanceChart from '../components/BalanceChart.astro';
import WhatsAppMock from '../components/WhatsAppMock.astro';
import ProblemChart from '../components/ProblemChart.astro';
import MediaStory from '../components/MediaStory.astro';
import JourneyThread from '../components/JourneyThread.astro';
import TrustedCompanies from '../components/TrustedCompanies.jsx';
import { LuCloudSun, LuSprout, LuCloudRain, LuLayers, LuMonitor, LuSmartphone } from 'react-icons/lu';
import { INTRO, PROBLEMA, MEJORA, PARA_QUIEN } from '../data/vigia';
import { buildWhatsAppUrl } from '../data/social';
import { VIDEOS, DESCRIPCION_PENDIENTE } from '../data/videos';
import '../styles/sections.css';

const ICONOS_DATOS = { clima: LuCloudSun, cultivo: LuSprout, agua: LuCloudRain, suelo: LuLayers };
const ICONOS_CANALES = { plataforma: LuMonitor, whatsapp: LuSmartphone };
const demoUrl = buildWhatsAppUrl('Hola, quiero conocer VigIA para mis lotes');
---

<BaseLayout>
  <!-- Los tres módulos comparten un fondo que cambia con la historia del
       lote y un hilo que los conecta (JourneyThread). -->
  <div class="vg-journey">
  <JourneyThread />

  <!-- 1. Introducción -->
  <section class="vg-hero" id="inicio">
    <div class="vg-wrap vg-hero__grid">
      <div class="vg-hero__copy">
        <p class="vg-eyebrow vg-eyebrow--lime" data-vg-node="1">{INTRO.etiqueta}</p>
        <h1 class="vg-hero__title">{INTRO.titulo}</h1>
        <p class="vg-hero__subtitle">{INTRO.descripcion}</p>
        <ul class="vg-checks vg-hero__points">
          {INTRO.puntos.map((p) => <li>{p}</li>)}
        </ul>
        <div class="vg-hero__ctas">
          <a class="vg-btn" href={demoUrl} target="_blank" rel="noopener noreferrer">Quiero una demo</a>
          <a class="vg-btn vg-btn--ghost" href="#mejora">Cómo funciona</a>
        </div>
      </div>
      <div class="vg-media">
        <MediaStory duracion={7500}>
          <BalanceChart />
        </MediaStory>
      </div>
    </div>
  </section>

  <!-- 2. Qué problema resuelve -->
  <section class="vg-section" id="problema">
    <div class="vg-wrap">
      <p class="vg-eyebrow vg-eyebrow--amber" data-vg-node="2">{PROBLEMA.etiqueta}</p>
      <h2 class="vg-section__title">{PROBLEMA.titulo}</h2>
      <p class="vg-section__lead">{PROBLEMA.bajada}</p>

      <div class="vg-problema">
        <div class="vg-problems">
          {
            PROBLEMA.razones.map((r, i) => (
              <article class="vg-problem">
                <span class="vg-problem__num">0{i + 1}</span>
                <h3>{r.titulo}</h3>
                <p>{r.texto}</p>
              </article>
            ))
          }
        </div>

        <div class="vg-media">
          <MediaStory duracion={6500} video={VIDEOS.problema} pendiente={DESCRIPCION_PENDIENTE.problema}>
            <ProblemChart />
          </MediaStory>
        </div>
      </div>

      <div class="vg-stress">
        <p class="vg-stress__label">Qué estrés mitiga VigIA</p>
        {
          PROBLEMA.estreses.map((e) => (
            <p class={`vg-stress__item vg-stress__item--${e.id}`}>
              <strong>{e.nombre}.</strong> {e.texto}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. La mejora real -->
  <section class="vg-section" id="mejora">
    <div class="vg-wrap">
      <p class="vg-eyebrow vg-eyebrow--lime" data-vg-node="3">{MEJORA.etiqueta}</p>
      <h2 class="vg-section__title">{MEJORA.titulo}</h2>
      <p class="vg-section__lead">{MEJORA.bajada}</p>

      <div class="vg-mejora">
        <div class="vg-mejora__alertas">
          {
            MEJORA.alertas.map((a) => (
              <div class={`vg-alert vg-alert--${a.severidad}`}>
                <span class="vg-alert__chip">{a.etiqueta}</span>
                <p class="vg-alert__title">{a.titulo}</p>
                <p class="vg-alert__action">{a.accion}</p>
              </div>
            ))
          }
          <ul class="vg-canales">
            {
              MEJORA.canales.map((c) => {
                const Icon = ICONOS_CANALES[c.id as keyof typeof ICONOS_CANALES];
                return (
                  <li>
                    <span class="vg-canales__icon"><Icon /></span>
                    <span>
                      <strong>{c.titulo}.</strong> {c.texto}
                    </span>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-media">
          <MediaStory duracion={4500} video={VIDEOS.resolucion} pendiente={DESCRIPCION_PENDIENTE.resolucion}>
            <WhatsAppMock />
          </MediaStory>
        </div>
      </div>

      <div class="vg-datos">
        <p class="vg-datos__label">Cómo lo logra</p>
        <ul class="vg-datos__list">
          {
            MEJORA.datos.map((d) => {
              const Icon = ICONOS_DATOS[d.id as keyof typeof ICONOS_DATOS];
              return (
                <li class="vg-datos__item">
                  <span class="vg-datos__icon"><Icon /></span>
                  <h3>{d.titulo}</h3>
                  <p>{d.texto}</p>
                </li>
              );
            })
          }
        </ul>
      </div>

      <p class="vg-servicio" data-vg-end>
        <strong>{MEJORA.cultivoServicio.pregunta}</strong> {MEJORA.cultivoServicio.texto}
      </p>
    </div>
  </section>

  </div>

  <!-- Para quién es -->
  <section class="vg-section vg-section--compact" id="para-quien">
    <div class="vg-wrap">
      <p class="vg-eyebrow">{PARA_QUIEN.etiqueta}</p>
      <h2 class="vg-section__title">{PARA_QUIEN.titulo}</h2>
      <div class="vg-perfiles">
        {
          PARA_QUIEN.perfiles.map((p) => (
            <article class="vg-perfil">
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </article>
          ))
        }
      </div>
      <p class="vg-perfiles__nota">{PARA_QUIEN.nota}</p>
    </div>
  </section>

  <section class="vg-trusted" id="clientes">
    <h2 class="vg-trusted__title">Confían en nosotros</h2>
    <TrustedCompanies client:visible />
  </section>

  <section class="vg-section vg-cta">
    <div class="vg-wrap vg-cta__inner">
      <h2>Que el bioinsumo llegue antes que el estrés</h2>
      <p>Contanos tus lotes y te mostramos VigIA funcionando con tus datos.</p>
      <a class="vg-btn vg-btn--light" href={demoUrl} target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp</a>
    </div>
  </section>
</BaseLayout>
