---
// Home de VigIA BioEstrés (versión 2 de doc/landing/ESTRUCTURA_LANDING.md):
// Hero → El problema → Cómo funciona (recorrido del mismo lote) → Frase
// destacada → Beneficios → Para quién es → Clientes → Preguntas → Cierre.
// Contenido en src/data/vigia.js. Los medios de las tres primeras secciones
// usan MediaStory: animación en código y, si hay, el video (src/data/videos.js).
import BaseLayout from '../layouts/BaseLayout.astro';
import BalanceChart from '../components/BalanceChart.astro';
import WhatsAppMock from '../components/WhatsAppMock.astro';
import ProblemChart from '../components/ProblemChart.astro';
import MediaStory from '../components/MediaStory.astro';
import JourneyThread from '../components/JourneyThread.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import TrustedCompanies from '../components/TrustedCompanies.jsx';
import {
  PiSquaresFour,
  PiWhatsappLogo,
  PiPlant,
  PiHourglassMedium,
  PiCloudSun,
  PiDrop,
  PiThermometerHot,
  PiCalendarDots,
  PiWarningDiamond,
  PiBellRinging,
  PiMonitor,
  PiClockCountdown,
  PiCrosshair,
  PiChartLineUp,
  PiCaretDown,
  PiArrowRight,
  PiCheck,
  PiCheckCircle,
  PiTractor,
  PiClipboardText,
} from 'react-icons/pi';
import {
  CTA,
  SEO,
  HERO,
  PROBLEMA,
  COMO_FUNCIONA,
  FRASE,
  BENEFICIOS,
  PARA_QUIEN,
  PREGUNTAS,
  CIERRE,
} from '../data/vigia';
import { buildWhatsAppUrl } from '../data/social';
import { VIDEOS, DESCRIPCION_PENDIENTE } from '../data/videos';
import '../styles/sections.css';

const ICONOS_HERO = { aviso: PiBellRinging, ambiente: PiSquaresFour, whatsapp: PiWhatsappLogo };
const ICONOS_RAZONES = { sintoma: PiPlant, bioinsumo: PiHourglassMedium, pronostico: PiCloudSun };
const ICONOS_ESTRES = { hidrico: PiDrop, termico: PiThermometerHot, combinado: PiWarningDiamond };
const ICONOS_CANALES = { plataforma: PiMonitor, whatsapp: PiWhatsappLogo };
const ICONOS_ALERTAS = { hidrico: PiDrop, critico: PiCalendarDots, combinado: PiThermometerHot };
const ICONOS_PERFILES = { productores: PiTractor, asesores: PiClipboardText };
const ICONOS_BENEFICIOS = { ventaja: PiClockCountdown, insumo: PiCrosshair, merma: PiChartLineUp };
// Escalonado de las apariciones al hacer scroll ([data-reveal], global.css).
const delay = (i: number) => `--reveal-delay: ${i * 100}ms`;
const ctaUrl = buildWhatsAppUrl(CTA.mensajeWhatsApp);

// Datos estructurados de las preguntas frecuentes, para buscadores.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PREGUNTAS.items.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---

<BaseLayout title={SEO.titulo} description={SEO.descripcion} jsonLd={faqJsonLd}>
  <!-- Las tres primeras secciones comparten un fondo que cambia con la
       historia del lote y un hilo que las conecta (JourneyThread). -->
  <div class="vg-journey">
  <JourneyThread />

  <!-- 1. Hero -->
  <section class="vg-hero" id="inicio">
    <div class="vg-wrap vg-hero__grid">
      <div class="vg-hero__copy">
        <p class="vg-eyebrow vg-eyebrow--lime" data-vg-node="1">{HERO.etiqueta}</p>
        <h1 class="vg-hero__title" data-reveal>{HERO.titulo}</h1>
        <p class="vg-hero__subtitle" data-reveal style={delay(1)}>{HERO.bajada}</p>
        <ul class="vg-hero__cards">
          {
            HERO.puntos.map((p, i) => {
              const Icon = ICONOS_HERO[p.id as keyof typeof ICONOS_HERO];
              return (
                <li class="vg-hero__card" data-reveal style={delay(i + 2)}>
                  <span class="vg-hero__card-icon" aria-hidden="true"><Icon /></span>
                  <strong>{p.titulo}</strong>
                  <span>{p.texto}</span>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div class="vg-media" data-reveal style={delay(2)}>
        <MediaStory duracion={7500}>
          <BalanceChart />
        </MediaStory>
      </div>
    </div>
    <!-- Botones en su propia fila, centrados bajo las dos columnas: así la
         columna de texto termina en las tarjetas, a la altura del gráfico. -->
    <div class="vg-wrap vg-hero__ctas" data-reveal style={delay(5)}>
      <a class="vg-btn vg-btn--lg" href={ctaUrl} target="_blank" rel="noopener noreferrer">
        {CTA.texto}
        <PiArrowRight aria-hidden="true" />
      </a>
      <a class="vg-btn vg-btn--ghost vg-btn--lg" href={HERO.secundario.href}>{HERO.secundario.texto}</a>
    </div>
  </section>

  <!-- 2. El problema -->
  <section class="vg-section" id="problema">
    <div class="vg-wrap">
      <!-- Título, bajada y razones en la columna izquierda: el gráfico queda
           centrado a la derecha, entre el título y las razones. -->
      <div class="vg-problema">
        <div class="vg-problema__texto">
          <p class="vg-eyebrow vg-eyebrow--amber" data-vg-node="2">{PROBLEMA.etiqueta}</p>
          <h2 class="vg-section__title" data-reveal>{PROBLEMA.titulo}</h2>
          <p class="vg-section__lead" data-reveal style={delay(1)}>{PROBLEMA.bajada}</p>
          <ul class="vg-razones">
            {
              PROBLEMA.razones.map((r, i) => {
                const Icon = ICONOS_RAZONES[r.id as keyof typeof ICONOS_RAZONES];
                return (
                  <li class="vg-razon" data-reveal style={delay(i)}>
                    <span class="vg-razon__icon" aria-hidden="true"><Icon /></span>
                    <div>
                      <h3>{r.titulo}</h3>
                      <p>{r.texto}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-media" data-reveal style={delay(1)}>
          <MediaStory duracion={6500} video={VIDEOS.problema} pendiente={DESCRIPCION_PENDIENTE.problema}>
            <ProblemChart />
          </MediaStory>
        </div>
      </div>

      <div class="vg-estres">
        <p class="vg-estres__label" data-reveal>Qué estrés mitiga VigIA</p>
        <ul class="vg-estres__list">
          {
            PROBLEMA.estreses.map((e, i) => {
              const Icon = ICONOS_ESTRES[e.id as keyof typeof ICONOS_ESTRES];
              return (
                <li class={`vg-estres__item vg-estres__item--${e.id}`} data-reveal style={delay(i)}>
                  <span class="vg-estres__bar" aria-hidden="true" />
                  <h3>
                    <span class="vg-estres__icon" aria-hidden="true"><Icon /></span>
                    {e.nombre}
                  </h3>
                  <p>{e.texto}</p>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Cómo funciona: los dos canales de la alerta son lo principal -->
  <section class="vg-section" id="como-funciona">
    <div class="vg-wrap">
      <!-- Título, bajada y canales a la izquierda; el WhatsApp con el video a
           la derecha, terminando a la altura de la tarjeta de la plataforma. -->
      <div class="vg-avisos">
        <div class="vg-avisos__texto">
          <p class="vg-eyebrow vg-eyebrow--lime" data-vg-node="3">{COMO_FUNCIONA.etiqueta}</p>
          <h2 class="vg-section__title" data-reveal>{COMO_FUNCIONA.titulo}</h2>
          <p class="vg-section__lead" data-reveal style={delay(1)}>{COMO_FUNCIONA.bajada}</p>
          <ul class="vg-canales">
            {
              COMO_FUNCIONA.canales.map((c, i) => {
                const Icon = ICONOS_CANALES[c.id as keyof typeof ICONOS_CANALES];
                return (
                  <li class={`vg-canal vg-canal--${c.id}`} data-reveal style={delay(i)}>
                    <span class="vg-canal__icon" aria-hidden="true"><Icon /></span>
                    <div>
                      <h3>{c.titulo}</h3>
                      <p>{c.texto}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-media" data-reveal style={delay(1)}>
          <MediaStory duracion={4500} cierre={3200} video={VIDEOS.resolucion} pendiente={DESCRIPCION_PENDIENTE.resolucion}>
            <WhatsAppMock />
          </MediaStory>
        </div>
      </div>

      <!-- Un panel con dos subsecciones: qué te avisa y cómo lo hace. -->
      <div class="vg-detalle" data-reveal>
        <div class="vg-detalle__col">
          <h3 class="vg-detalle__label">Qué te avisa</h3>
          <ul class="vg-detalle__list">
            {
              COMO_FUNCIONA.alertas.map((a) => {
                const Icon = ICONOS_ALERTAS[a.id as keyof typeof ICONOS_ALERTAS];
                return (
                  <li class={`vg-aviso vg-aviso--${a.tono}`}>
                    <span class="vg-aviso__icon" aria-hidden="true"><Icon /></span>
                    <div>
                      <p class="vg-aviso__titulo">{a.titulo}</p>
                      <p>{a.texto}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="vg-detalle__col">
          <h3 class="vg-detalle__label">Cómo lo hace</h3>
          <ol class="vg-detalle__list">
            {
              COMO_FUNCIONA.pasos.map((p, i) => (
                <li class="vg-aviso">
                  <span class="vg-paso-num">{i + 1}</span>
                  <div>
                    <p class="vg-aviso__titulo">{p.titulo}</p>
                    <p>{p.texto}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <p class="vg-servicio" data-vg-end>
        <strong>{COMO_FUNCIONA.cultivoServicio.pregunta}</strong> {COMO_FUNCIONA.cultivoServicio.texto}
      </p>
    </div>
  </section>

  </div>

  <!-- 4. Frase destacada -->
  <TaglineReveal lineas={FRASE} />

  <!-- 5. Beneficios -->
  <section class="vg-section vg-section--compact" id="beneficios">
    <div class="vg-wrap">
      <p class="vg-eyebrow">{BENEFICIOS.etiqueta}</p>
      <h2 class="vg-section__title" data-reveal>{BENEFICIOS.titulo}</h2>
      <div class="vg-beneficios">
        {
          BENEFICIOS.items.map((b, i) => {
            const Icon = ICONOS_BENEFICIOS[b.id as keyof typeof ICONOS_BENEFICIOS];
            return (
              <article class="vg-beneficio" data-reveal style={delay(i)}>
                <span class="vg-beneficio__icon" aria-hidden="true"><Icon /></span>
                <h3>{b.titulo}</h3>
                <p>{b.texto}</p>
                <p class="vg-beneficio__resultado">
                  <PiCheckCircle aria-hidden="true" />
                  <span>{b.resultado}</span>
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 6. Para quién es -->
  <section class="vg-section vg-section--compact" id="para-quien">
    <div class="vg-wrap">
      <p class="vg-eyebrow">{PARA_QUIEN.etiqueta}</p>
      <h2 class="vg-section__title" data-reveal>{PARA_QUIEN.titulo}</h2>
      <div class="vg-perfiles">
        {
          PARA_QUIEN.perfiles.map((p, i) => {
            const Icon = ICONOS_PERFILES[p.id as keyof typeof ICONOS_PERFILES];
            return (
              <article class="vg-perfil" data-reveal style={delay(i)}>
                <header class="vg-perfil__head">
                  <span class="vg-perfil__icon" aria-hidden="true"><Icon /></span>
                  <div>
                    <h3>{p.titulo}</h3>
                    <p class="vg-perfil__lema">{p.lema}</p>
                  </div>
                </header>
                <ul class="vg-perfil__puntos">
                  {
                    p.puntos.map((punto) => (
                      <li>
                        <PiCheck aria-hidden="true" />
                        <span>{punto}</span>
                      </li>
                    ))
                  }
                </ul>
                <p class="vg-perfil__clave">
                  <span>Beneficio clave</span>
                  {p.clave}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 7. Clientes -->
  <section class="vg-trusted" id="clientes">
    <h2 class="vg-trusted__title" data-reveal>Confían en nosotros</h2>
    <TrustedCompanies client:visible />
  </section>

  <!-- 8. Preguntas frecuentes -->
  <section class="vg-section vg-section--compact" id="preguntas">
    <div class="vg-wrap vg-faq">
      <div class="vg-faq__head">
        <p class="vg-eyebrow">{PREGUNTAS.etiqueta}</p>
        <h2 class="vg-section__title" data-reveal>{PREGUNTAS.titulo}</h2>
      </div>
      <div class="vg-faq__list" data-reveal style={delay(1)}>
        {
          PREGUNTAS.items.map((p) => (
            <details class="vg-faq__item">
              <summary>
                <span>{p.pregunta}</span>
                <PiCaretDown className="vg-faq__caret" aria-hidden="true" />
              </summary>
              <p>{p.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 9. Cierre -->
  <section class="vg-section vg-cta">
    <div class="vg-wrap vg-cta__inner">
      <h2 data-reveal>{CIERRE.titulo}</h2>
      <p data-reveal style={delay(1)}>{CIERRE.texto}</p>
      <a data-reveal style={delay(2)} class="vg-btn vg-btn--light" href={ctaUrl} target="_blank" rel="noopener noreferrer">{CTA.texto}</a>
    </div>
  </section>
</BaseLayout>
