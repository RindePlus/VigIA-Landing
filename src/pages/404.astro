---
// Astro genera docs/404.html, que GitHub Pages sirve para rutas inexistentes.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/sections.css';
---

<BaseLayout title="Página no encontrada · VigIA" showMenu={false}>
  <section class="vg-section vg-hero">
    <h1 class="vg-hero__title">404</h1>
    <p class="vg-hero__subtitle">La página que buscás no existe.</p>
    <a class="vg-btn" href="/">Volver al inicio</a>
  </section>
</BaseLayout>
