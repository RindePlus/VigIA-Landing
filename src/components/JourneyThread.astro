---
// Hilo que conecta los cuatro módulos (Hero → Problema → Solución → Cómo funciona)
// y fondo que cambia de tono con la historia del lote. Va dentro de
// `.vg-journey` (ver index.astro):
// - Los puntos del hilo son los elementos con `data-vg-node` (1 a 4); el
//   hilo termina en el elemento con `data-vg-end`.
// - La línea se dibuja con el scroll: verde (VigIA vigila) → ámbar y rojo
//   (el lote sin aviso) → celeste (la solución) → verde (el lote se salva).
// - Al final no corta en seco: baja por el costado y dobla para entrar de
//   costado en la frase destacada (.vg-tagline__text), a la altura de su
//   renglón del medio, con un punto verde que late al llegar.
// - El avance se mide por el largo de la línea (no sólo por la altura), así
//   los tramos de costado también se dibujan de a poco.
// - El fondo cambia en el borde de cada sección: página → seco → solución
//   → agua → página, con fundidos largos.
// - Con movimiento reducido el hilo aparece completo y quieto. Sin JS no se
//   dibuja el hilo y queda el fondo de respaldo de sections.css.
---

<svg class="vg-thread" aria-hidden="true" data-vg-thread>
  <defs>
    <linearGradient id="vg-thread-grad" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="1">
      <stop data-stop="ok-a" style="stop-color: var(--vg-thread-ok)" />
      <stop data-stop="ok-b" style="stop-color: var(--vg-thread-ok)" />
      <stop data-stop="amber" style="stop-color: var(--vg-sev-alerta)" />
      <stop data-stop="red" style="stop-color: var(--vg-sev-critico)" />
      <stop data-stop="sky-a" style="stop-color: var(--vg-sky)" />
      <stop data-stop="sky-b" style="stop-color: var(--vg-sky)" />
      <stop data-stop="ok-c" style="stop-color: var(--vg-thread-ok)" />
      <stop data-stop="ok-d" style="stop-color: var(--vg-thread-ok)" />
    </linearGradient>
  </defs>
  <path class="vg-thread__track" />
  <path class="vg-thread__line" stroke="url(#vg-thread-grad)" />
  <g class="vg-thread__nodes"></g>
</svg>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const NODE_COLOR = ['var(--vg-thread-ok)', 'var(--vg-sev-alerta)', 'var(--vg-sky)', 'var(--vg-thread-ok)'];

  const journey = document.querySelector<HTMLElement>('.vg-journey');
  const svg = journey?.querySelector<SVGSVGElement>('[data-vg-thread]');

  if (journey && svg) {
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    const track = svg.querySelector<SVGPathElement>('.vg-thread__track')!;
    const line = svg.querySelector<SVGPathElement>('.vg-thread__line')!;
    const grad = svg.querySelector<SVGLinearGradientElement>('#vg-thread-grad')!;
    const nodesGroup = svg.querySelector<SVGGElement>('.vg-thread__nodes')!;
    const anchors = [...journey.querySelectorAll<HTMLElement>('[data-vg-node]')];
    const end = journey.querySelector<HTMLElement>('[data-vg-end]');

    let geo: {
      nodes: { x: number; y: number }[];
      yStart: number;
      yEnd: number;
      length: number;
      // Muestras del recorrido: largo de la línea y "avance" acumulado
      // (vertical completo + un décimo del horizontal) en px de scroll. El
      // horizontal pesa poco para que el tramo final, que dobla hacia la frase,
      // no pida mucho scroll: el punto llega con la frase a mitad de pantalla.
      largos: number[];
      avances: number[];
    } | null = null;
    let nodeEls: SVGGElement[] = [];
    let endEl: SVGGElement | null = null;

    const setStop = (name: string, offset: number) => {
      grad.querySelector(`[data-stop="${name}"]`)?.setAttribute('offset', String(Math.min(1, Math.max(0, offset))));
    };

    const layout = () => {
      const jr = journey.getBoundingClientRect();
      const W = jr.width;
      const H = journey.offsetHeight;
      if (!anchors.length || !W || !H) return;

      const nodes = anchors.map((a) => {
        const r = a.getBoundingClientRect();
        return { x: r.left - jr.left - 36, y: r.top - jr.top + r.height / 2 };
      });
      const x = Math.max(18, Math.min(...nodes.map((n) => n.x)));
      nodes.forEach((n) => (n.x = x));
      const yServicio = end ? end.getBoundingClientRect().bottom - jr.top : H - 40;
      const amp = W > 960 ? 16 : 6;

      // Desemboque en la frase destacada (está después del recorrido, fuera
      // de .vg-journey; el SVG dibuja por fuera con overflow visible).
      // Punto de llegada: a la izquierda del renglón visual del medio de la
      // frase (el texto se parte distinto según el ancho, así que se miden
      // las palabras: la fila más cercana al centro y su palabra de más a la
      // izquierda).
      const frase = document.querySelector<HTMLElement>('.vg-tagline__text');
      const palabras = [...document.querySelectorAll<HTMLElement>('.vg-tagline__word')].map((w) =>
        w.getBoundingClientRect(),
      );
      let fin: { x: number; y: number } | null = null;
      if (frase && palabras.length) {
        const fr = frase.getBoundingClientRect();
        const centro = fr.top + fr.height / 2;
        const fila = palabras.reduce((best, r) =>
          Math.abs(r.top + r.height / 2 - centro) < Math.abs(best.top + best.height / 2 - centro) ? r : best,
        );
        const enFila = palabras.filter((r) => Math.abs(r.top - fila.top) < fila.height / 2);
        const izq = Math.min(...enFila.map((r) => r.left));
        fin = { x: Math.max(x + 40, izq - jr.left - 28), y: fila.top - jr.top + fila.height / 2 };
      }
      const yEnd = fin ? fin.y : yServicio;

      // Curvas suaves entre puntos: el hilo serpentea como un trazado de campo.
      let d = `M${x} ${nodes[0].y}`;
      for (let i = 1; i < nodes.length; i++) {
        const y1 = nodes[i - 1].y;
        const y2 = nodes[i].y;
        const dy = y2 - y1;
        d += ` C${x + amp} ${y1 + dy / 3} ${x - amp} ${y1 + (2 * dy) / 3} ${x} ${y2}`;
      }
      d += ` L${x} ${yServicio}`;
      if (fin) {
        // Baja por el costado y dobla hacia la derecha: llega en horizontal.
        const dx = fin.x - x;
        d += ` C${x} ${fin.y} ${x + dx * 0.35} ${fin.y} ${fin.x} ${fin.y}`;
      }

      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('width', String(W));
      svg.setAttribute('height', String(H));
      track.setAttribute('d', d);
      line.setAttribute('d', d);

      // Colores de la línea según la historia.
      const yStart = nodes[0].y;
      const f = (y: number) => (y - yStart) / (yEnd - yStart);
      grad.setAttribute('y1', String(yStart));
      grad.setAttribute('y2', String(yEnd));
      const n2 = f(nodes[1]?.y ?? yEnd);
      const n3 = f(nodes[2]?.y ?? yEnd);
      const n4 = f(nodes[3]?.y ?? yEnd);
      setStop('ok-a', 0);
      setStop('ok-b', n2 - 0.06);
      setStop('amber', n2);
      setStop('red', n2 + (n3 - n2) * 0.6);
      setStop('sky-a', n3);
      setStop('sky-b', n4 - (n4 - n3) * 0.25);
      setStop('ok-c', n4);
      setStop('ok-d', 1);

      // Puntos numerados.
      nodesGroup.replaceChildren();
      nodeEls = nodes.map((n, i) => {
        const g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('class', 'vg-thread__node');
        g.setAttribute('style', `--c: ${NODE_COLOR[i] ?? NODE_COLOR[0]}`);
        const c = document.createElementNS(SVG_NS, 'circle');
        c.setAttribute('cx', String(n.x));
        c.setAttribute('cy', String(n.y));
        c.setAttribute('r', W > 680 ? '13' : '9');
        const t = document.createElementNS(SVG_NS, 'text');
        t.setAttribute('x', String(n.x));
        t.setAttribute('y', String(n.y));
        t.textContent = String(i + 1);
        g.append(c, t);
        nodesGroup.append(g);
        return g;
      });

      // Punto final sobre la frase: late cuando el hilo llega.
      endEl = null;
      if (fin) {
        const g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('class', 'vg-thread__end');
        const ring = document.createElementNS(SVG_NS, 'circle');
        ring.setAttribute('class', 'vg-thread__end-ring');
        ring.setAttribute('cx', String(fin.x));
        ring.setAttribute('cy', String(fin.y));
        ring.setAttribute('r', '14');
        const dot = document.createElementNS(SVG_NS, 'circle');
        dot.setAttribute('class', 'vg-thread__end-dot');
        dot.setAttribute('cx', String(fin.x));
        dot.setAttribute('cy', String(fin.y));
        dot.setAttribute('r', '6');
        g.append(ring, dot);
        nodesGroup.append(g);
        endEl = g;
      }

      // Fondo: página → seco (problema) → solución → agua (cómo funciona) →
      // página. Cada
      // cambio es un fundido largo centrado en el borde real de la sección,
      // con curva suave (smoothstep en pasos de color-mix, mezclado en oklab):
      // sin escalón visible ni bandas en los extremos del fundido.
      const secciones = [...journey.querySelectorAll<HTMLElement>(':scope > section')];
      const borde = (i: number, fallback: number) =>
        secciones[i] ? secciones[i].getBoundingClientRect().top - jr.top : fallback;
      const b2 = borde(1, H * 0.3);
      const b3 = borde(2, H * 0.5);
      const b4 = borde(3, H * 0.7);
      const T = Math.min(240, (b3 - b2) / 4, (b4 - b3) / 4);
      const PASOS = 8;
      const fundido = (de: string, a: string, desde: number, hasta: number) =>
        Array.from({ length: PASOS + 1 }, (_, i) => {
          const t = i / PASOS;
          const s = Math.round(t * t * (3 - 2 * t) * 100);
          return `color-mix(in oklab, ${a} ${s}%, ${de}) ${(desde + (hasta - desde) * t).toFixed(1)}px`;
        }).join(', ');
      const canvas = 'var(--gh-canvas)';
      const seco = 'var(--vg-bg-seco)';
      const solucion = 'var(--vg-bg-solucion)';
      const agua = 'var(--vg-bg-agua)';
      const pagina = 'var(--vg-bg-pagina)';
      journey.style.background = `linear-gradient(to bottom, ${canvas} 0px,
        ${fundido(canvas, seco, b2 - T, b2 + T)},
        ${fundido(seco, solucion, b3 - T, b3 + T)},
        ${fundido(solucion, agua, b4 - T, b4 + T)},
        ${fundido(agua, pagina, Math.max(b4 + T, H - 2 * T), H)})`;

      const length = line.getTotalLength();
      const largos: number[] = [];
      const avances: number[] = [];
      const N = 300;
      let prev = line.getPointAtLength(0);
      let acc = 0;
      for (let i = 0; i <= N; i++) {
        const L = (length * i) / N;
        const p = line.getPointAtLength(L);
        acc += Math.abs(p.y - prev.y) + Math.abs(p.x - prev.x) * 0.1;
        largos.push(L);
        avances.push(acc);
        prev = p;
      }
      geo = { nodes, yStart, yEnd, length, largos, avances };
      line.style.strokeDasharray = String(geo.length);
      update();
    };

    const update = () => {
      if (!geo) return;
      const jr = journey.getBoundingClientRect();
      // Punta del hilo un poco arriba de la mitad de la pantalla.
      const target = reduceMotion ? Infinity : window.innerHeight * 0.55 - jr.top;
      // Avance en px de scroll desde el primer punto → largo dibujado.
      const avance = target - geo.yStart;
      const { largos, avances } = geo;
      let dibujado = 0;
      if (avance >= avances[avances.length - 1]) dibujado = geo.length;
      else if (avance > 0) {
        const i = avances.findIndex((a) => a >= avance);
        const a0 = avances[i - 1] ?? 0;
        const t = (avance - a0) / (avances[i] - a0 || 1);
        dibujado = (largos[i - 1] ?? 0) + t * (largos[i] - (largos[i - 1] ?? 0));
      }
      line.style.strokeDashoffset = String(geo.length - dibujado);
      geo.nodes.forEach((n, i) => nodeEls[i]?.classList.toggle('is-reached', target >= n.y));
      endEl?.classList.toggle('is-reached', dibujado >= geo.length - 12);
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );

    // Recalcula si cambia el alto (fuentes, imágenes, tamaño de ventana).
    new ResizeObserver(() => layout()).observe(journey);
    layout();
  }
</script>
