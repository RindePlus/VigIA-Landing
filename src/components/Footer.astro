---
// Componente estático (sin JS en el cliente): los contactos son links reales.
import { PiEnvelopeSimple, PiMapPin, PiWhatsappLogo, PiInstagramLogo } from 'react-icons/pi';
import {
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  INSTAGRAM_HANDLE,
  WHATSAPP_URL,
  WHATSAPP_DISPLAY,
  OFFICE_ADDRESS,
} from '../data/social';
import { MARCA } from '../data/vigia';
import './Footer.css';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(OFFICE_ADDRESS)}`;
const year = new Date().getFullYear();
---

<footer class="rp-footer" id="contacto">
  <div class="rp-footer__dots"></div>
  <div class="rp-footer__inner">
    <h3 class="rp-footer__column-title">Contacto directo</h3>

    <ul class="rp-footer__contact">
      <li>
        <a class="rp-footer__contact-item" href={`mailto:${CONTACT_EMAIL}`}>
          <span class="rp-footer__contact-icon rp-footer__contact-icon--blue"><PiEnvelopeSimple /></span>
          <span class="rp-footer__contact-text">
            <span class="rp-footer__contact-label">Email</span>
            <span class="rp-footer__contact-value">{CONTACT_EMAIL}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="rp-footer__contact-item" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
          <span class="rp-footer__contact-icon rp-footer__contact-icon--instagram"><PiInstagramLogo /></span>
          <span class="rp-footer__contact-text">
            <span class="rp-footer__contact-label">Instagram</span>
            <span class="rp-footer__contact-value">{INSTAGRAM_HANDLE}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="rp-footer__contact-item" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
          <span class="rp-footer__contact-icon rp-footer__contact-icon--whatsapp"><PiWhatsappLogo /></span>
          <span class="rp-footer__contact-text">
            <span class="rp-footer__contact-label">WhatsApp</span>
            <span class="rp-footer__contact-value">{WHATSAPP_DISPLAY}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="rp-footer__contact-item" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <span class="rp-footer__contact-icon rp-footer__contact-icon--amber"><PiMapPin /></span>
          <span class="rp-footer__contact-text">
            <span class="rp-footer__contact-label">Oficina</span>
            <span class="rp-footer__contact-value">Concejal Lorusso 762 · Alta Gracia</span>
          </span>
        </a>
      </li>
    </ul>

    <div class="rp-footer__divider"></div>

    <div class="rp-footer__bottom">
      <p class="rp-footer__copyright">
        © {year} <strong>{MARCA}</strong> · una solución de Rinde Plus. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
