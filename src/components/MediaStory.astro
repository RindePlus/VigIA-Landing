---
// Contenedor de medios de cada módulo: primero corre la animación en código
// (el contenido del slot) y después, si hay video, se funde a él. Al terminar
// el video vuelve a empezar. Sin video, la animación se repite sola.
//
// - Sin JS o con `prefers-reduced-motion`: queda el estado final estático de
//   la animación y el video no se muestra.
// - Sólo corre mientras está a la vista; fuera de pantalla se detiene. El
//   video empieza a descargarse recién cuando el módulo entra en pantalla.
// - Las animaciones del slot se activan con la clase `.is-playing` en
//   `.vg-story__anim` (ver sections.css).
// - Con `cierre` (ms), al terminar el video vuelve la animación en su estado
//   final con `data-stage="cierre"` durante ese tiempo, antes de reiniciar:
//   el slot puede mostrar cómo terminó la historia (ver WhatsAppMock).
// - Durante el video se ve un rótulo de capítulo arriba a la izquierda (ícono
//   + texto en mayúsculas): sin él, el paso de la interfaz al campo no se
//   entiende. El ícono sale del `tono`: ⚠ crítico o ✓ ok.
import { PiWarningCircleFill, PiCheckCircleFill } from 'react-icons/pi';

interface Video {
  webm?: string;
  mp4?: string;
  poster?: string;
  descripcion?: string;
  /** Texto corto sobre el video ("Sin aviso · …"). */
  rotulo?: string;
  /** Ícono y color del rótulo: 'critico' (⚠ rojo) u 'ok' (✓ verde, por defecto). */
  tono?: string;
  /** `object-position` del video: qué parte se conserva cuando el contenedor
      es más angosto que 4:3 (en celular). */
  encuadre?: string;
}

interface Props {
  /** Duración de la animación en ms, antes de pasar al video o repetir. */
  duracion: number;
  /** Ms que se muestra el cierre después del video (0 = sin cierre). */
  cierre?: number;
  video?: Video | null;
  /** Nota visible sólo en `pnpm dev` cuando todavía no hay video. */
  pendiente?: string;
}

const { duracion, cierre = 0, video = null, pendiente } = Astro.props;
const mostrarPendiente = !video && pendiente && import.meta.env.DEV;
---

<div class="vg-story" data-vg-story data-duracion={duracion} data-cierre={cierre}>
  <div class="vg-story__anim">
    <slot />
  </div>
  {
    video && (
      <video
        class="vg-story__video"
        muted
        playsinline
        preload="none"
        poster={video.poster}
        aria-hidden="true"
        style={video.encuadre ? `object-position: ${video.encuadre}` : undefined}
      >
        {video.webm && <source src={video.webm} type="video/webm" />}
        {video.mp4 && <source src={video.mp4} type="video/mp4" />}
      </video>
    )
  }
  {
    video?.rotulo && (
      <p class={`vg-story__rotulo vg-story__rotulo--${video.tono ?? 'ok'}`} aria-hidden="true">
        {video.tono === 'critico' ? <PiWarningCircleFill /> : <PiCheckCircleFill />}
        <span>{video.rotulo}</span>
      </p>
    )
  }
  {mostrarPendiente && <p class="vg-story__pendiente">🎬 Pendiente: {pendiente}</p>}
</div>

<script>
  const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const VELOCIDAD_VIDEO = 0.75;

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-vg-story]').forEach((story) => {
      const anim = story.querySelector<HTMLElement>('.vg-story__anim');
      const video = story.querySelector<HTMLVideoElement>('.vg-story__video');
      const duracion = Number(story.dataset.duracion) || 7000;
      const cierre = Number(story.dataset.cierre) || 0;
      if (!anim) return;

      let timer: number | undefined;
      let visible = false;

      const playAnim = () => {
        story.dataset.stage = 'anim';
        anim.classList.remove('is-playing');
        void anim.offsetWidth; // reinicia las animaciones CSS
        anim.classList.add('is-playing');
        timer = window.setTimeout(afterAnim, duracion);
      };

      const afterAnim = () => {
        if (!visible) return;
        if (!video) {
          playAnim();
          return;
        }
        story.dataset.stage = 'video';
        video.currentTime = 0;
        // Los clips van a 0,75x: el campo se mira con calma. Las animaciones
        // en código conservan su velocidad.
        video.playbackRate = VELOCIDAD_VIDEO;
        video.play().catch(() => {
          // El video no cargó o el navegador no lo deja reproducir: sigue
          // sólo con la animación.
          playAnim();
        });
      };

      video?.addEventListener('ended', () => {
        if (!visible) return;
        if (!cierre) {
          playAnim();
          return;
        }
        // La animación sigue en su estado final (fill-mode both): sólo se
        // cambia la etapa para que el slot muestre el desenlace.
        story.dataset.stage = 'cierre';
        timer = window.setTimeout(() => {
          if (visible) playAnim();
        }, cierre);
      });

      const stop = () => {
        window.clearTimeout(timer);
        video?.pause();
        story.dataset.stage = 'anim';
      };

      new IntersectionObserver(
        ([entry]) => {
          const wasVisible = visible;
          visible = entry.isIntersecting;
          // El video arranca con preload="none" para no cargarlo si nunca se
          // ve; al entrar en pantalla se baja mientras corre la animación.
          if (visible && video && video.preload !== 'auto') video.preload = 'auto';
          if (visible && !wasVisible) playAnim();
          if (!visible && wasVisible) stop();
        },
        { threshold: 0.35 },
      ).observe(story);
    });
  }
</script>
