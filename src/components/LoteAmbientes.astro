---
// Fondo de Lo que hace VigIA (decorativo): lotes vistos desde arriba, como
// un mapa de agricultura de precisión. Una grilla de lotes de bordes
// apenas irregulares; dos de ellos, divididos en ambientes por curvas
// suaves. Cuenta el "por ambiente" de la sección.
// Se genera al compilar, siempre igual (sin azar): suma de senos.
// Vectores sin relleno; color y desvanecido en sections.css
// (.vg-fondo-linea--ambientes).

const W = 1200;
const H = 800;

const fmt = (n: number) => n.toFixed(1);
type P = [number, number];

// Arriba a la derecha, al lado del título y la bajada (las tarjetas
// ocupan el medio de la pantalla).
const X0 = 600;
const Y0 = -30;
const COLS = 4;
const FILAS = 2;
const ANCHO = 175;
const ALTO = 150;

// Esquinas compartidas por lotes vecinos, corridas apenas.
const esquina = (i: number, j: number): P => [
  X0 + i * ANCHO + 14 * Math.sin(i * 2.1 + j * 1.3) + j * 18,
  Y0 + j * ALTO + 10 * Math.sin(i * 1.7 + j * 2.9),
];

const lotes = Array.from({ length: COLS * FILAS }, (_, k) => {
  const i = k % COLS;
  const j = Math.floor(k / COLS);
  return [esquina(i, j), esquina(i + 1, j), esquina(i + 1, j + 1), esquina(i, j + 1)];
});

const poligono = (pts: P[]) => `M${pts.map(([x, y]) => `${fmt(x)} ${fmt(y)}`).join(' L')} Z`;

// Curva suave abierta (Catmull-Rom → Bézier cúbicas).
const suave = (p: P[]) => {
  let d = `M${fmt(p[0][0])} ${fmt(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[Math.max(0, i - 1)];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[Math.min(p.length - 1, i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${fmt(c1[0])} ${fmt(c1[1])} ${fmt(c2[0])} ${fmt(c2[1])} ${fmt(p2[0])} ${fmt(p2[1])}`;
  }
  return d;
};

// Ambientes: curvas que cruzan el lote de lado a lado, ondulando. Se
// recortan al lote con un clipPath.
const CON_AMBIENTES = [1, 6];
const conAmbientes = (lote: P[], k: number) => {
  const [a, b, , d] = lote;
  const curvas = [0.3, 0.55, 0.8].map((f, n) => {
    const pts: P[] = [];
    for (let s = 0; s <= 6; s++) {
      const t = s / 6;
      const x = a[0] - 20 + (b[0] - a[0] + 40) * t;
      const y = a[1] + (d[1] - a[1]) * f + 16 * Math.sin(t * 5 + n * 1.9 + k) + 8 * Math.sin(t * 11 + k);
      pts.push([x, y]);
    }
    return suave(pts);
  });
  return { id: `vg-ambientes-${k}`, lote: poligono(lote), curvas };
};
const ambientes = CON_AMBIENTES.map((k) => conAmbientes(lotes[k], k));

// Columna a la derecha de las tarjetas (no tapa texto: las tarjetas y las
// preguntas terminan antes): dos lotes apilados, el de arriba con
// ambientes. Va en su propio SVG, con su desvanecido.
// Arranca donde se desvanece la grilla de arriba, para no cruzarse con ella.
const lado: P[][] = [
  [
    [1085, 300],
    [1230, 293],
    [1236, 560],
    [1092, 568],
  ],
  [
    [1092, 568],
    [1236, 560],
    [1242, 830],
    [1098, 838],
  ],
];
const ambientesLado = conAmbientes(lado[0], 9);
---

<svg
  class="vg-fondo-linea vg-fondo-linea--ambientes"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {
      ambientes.map(({ id, lote }) => (
        <clipPath id={id}>
          <path d={lote} />
        </clipPath>
      ))
    }
  </defs>
  {lotes.map((l) => <path d={poligono(l)} />)}
  {
    ambientes.map(({ id, curvas }) => (
      <g clip-path={`url(#${id})`}>
        {curvas.map((d) => (
          <path d={d} />
        ))}
      </g>
    ))
  }
</svg>

<svg
  class="vg-fondo-linea vg-fondo-linea--ambientes-lado"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={ambientesLado.id}>
      <path d={ambientesLado.lote} />
    </clipPath>
  </defs>
  {lado.map((l) => <path d={poligono(l)} />)}
  <g clip-path={`url(#${ambientesLado.id})`}>
    {ambientesLado.curvas.map((d) => <path d={d} />)}
  </g>
</svg>
