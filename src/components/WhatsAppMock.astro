---
// Celular con un aviso de VigIA por WhatsApp. HTML + CSS (sin imagen) para
// que siga al tema claro/oscuro. Es ilustrativo: los datos salen de
// COMO_FUNCIONA.mensaje en src/data/vigia.js.
// Ocupa todo el recuadro del medio (4:3, como el video), así no cambia de
// tamaño al pasar al video. Mensaje simple: la alerta, dónde y qué hacer.
// Animación (con `.is-playing`, la dispara MediaStory): "escribiendo…" y
// llega el mensaje. Sin ella, se ve el mensaje.
// Cierre (`data-stage="cierre"` en MediaStory, después del video): la alerta
// pasa a "Resuelta", espejo del "Sin aviso" del gráfico del problema.
import { PiWhatsappLogo } from 'react-icons/pi';
import { COMO_FUNCIONA } from '../data/vigia';

const { lote, alerta, accion, hora, resuelta } = COMO_FUNCIONA.mensaje;
---

<figure class="vg-phone" aria-label="Ejemplo de alerta de VigIA por WhatsApp">
  <div class="vg-phone__screen">
    <div class="vg-phone__bar">
      <span class="vg-phone__avatar" aria-hidden="true">V</span>
      <span class="vg-phone__contact">
        <strong>VigIA</strong>
        <small>Alertas de tus lotes</small>
      </span>
      <PiWhatsappLogo className="vg-phone__wa" aria-hidden="true" />
    </div>

    <div class="vg-phone__chat">
      <span class="vg-phone__typing" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="vg-phone__bubble">
        <p class="vg-phone__alerta">
          <span class="vg-phone__aviso"><span aria-hidden="true">⚠️</span> {alerta}</span>
          <span class="vg-phone__resuelta" aria-hidden="true"><span>✅</span> {resuelta}</span>
        </p>
        <p class="vg-phone__lote">{lote}</p>
        <p>{accion}</p>
        <span class="vg-phone__time">{hora}</span>
      </div>
    </div>
  </div>
</figure>
