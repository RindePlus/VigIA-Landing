---
// Fondo de conexión entre El problema y Lo que hace VigIA, sólo con scroll
// normal (celular, vertical): lotes vistos desde arriba, del mismo tamaño
// y trazo que los de LoteAmbientes (pocas líneas). Arranca a mitad de El
// problema y sigue por debajo del comienzo de Lo que hace VigIA, así las
// dos secciones quedan unidas por el mismo campo.
// Se genera al compilar, siempre igual (sin azar): suma de senos.
// Vectores sin relleno; posición, color y desvanecido en sections.css
// (.vg-fondo-linea--lotes).

const W = 420;
const H = 1400;

const fmt = (n: number) => n.toFixed(1);
type P = [number, number];

const COLS = 3;
const FILAS = 10;
const ANCHO = 180;
const ALTO = 150;
const X0 = -60;
const Y0 = -20;

// Esquinas compartidas por lotes vecinos, corridas apenas.
const esquina = (i: number, j: number): P => [
  X0 + i * ANCHO + 14 * Math.sin(i * 2.1 + j * 1.3),
  Y0 + j * ALTO + 10 * Math.sin(i * 1.7 + j * 2.9),
];

const lotes = Array.from({ length: COLS * FILAS }, (_, k) => {
  const i = k % COLS;
  const j = Math.floor(k / COLS);
  return [esquina(i, j), esquina(i + 1, j), esquina(i + 1, j + 1), esquina(i, j + 1)];
});

const poligono = (pts: P[]) => `M${pts.map(([x, y]) => `${fmt(x)} ${fmt(y)}`).join(' L')} Z`;

// Curva suave abierta (Catmull-Rom → Bézier cúbicas).
const suave = (p: P[]) => {
  let d = `M${fmt(p[0][0])} ${fmt(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[Math.max(0, i - 1)];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[Math.min(p.length - 1, i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${fmt(c1[0])} ${fmt(c1[1])} ${fmt(c2[0])} ${fmt(c2[1])} ${fmt(p2[0])} ${fmt(p2[1])}`;
  }
  return d;
};

// Algunos lotes divididos en ambientes, salteados: curvas que cruzan el
// lote ondulando, recortadas al lote con un clipPath.
const CON_AMBIENTES = [4, 9, 16, 23];
const ambientes = CON_AMBIENTES.map((k) => {
  const [a, b, , d] = lotes[k];
  const curvas = [0.3, 0.55, 0.8].map((f, n) => {
    const pts: P[] = [];
    for (let s = 0; s <= 6; s++) {
      const t = s / 6;
      const x = a[0] - 20 + (b[0] - a[0] + 40) * t;
      const y = a[1] + (d[1] - a[1]) * f + 16 * Math.sin(t * 5 + n * 1.9 + k) + 8 * Math.sin(t * 11 + k);
      pts.push([x, y]);
    }
    return suave(pts);
  });
  return { id: `vg-lotes-${k}`, lote: poligono(lotes[k]), curvas };
});
---

<svg
  class="vg-fondo-linea vg-fondo-linea--lotes"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMin slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {
      ambientes.map(({ id, lote }) => (
        <clipPath id={id}>
          <path d={lote} />
        </clipPath>
      ))
    }
  </defs>
  {lotes.map((l) => <path d={poligono(l)} />)}
  {
    ambientes.map(({ id, curvas }) => (
      <g clip-path={`url(#${id})`}>
        {curvas.map((d) => (
          <path d={d} />
        ))}
      </g>
    ))
  }
</svg>
