---
// Líneas de nivel de fondo (decorativas): curvas cerradas alrededor de dos
// lomas, como el relieve de un lote en un mapa topográfico. Es la única
// textura de la página y sale del mundo del producto (ambientes del lote).
// Se generan al compilar, siempre iguales (sin azar): suma de senos.
// Vectores nítidos, sin relleno; el color y la opacidad los da el CSS
// (.vg-topo en sections.css).

const W = 1200;
const H = 800;
const PUNTOS = 72;

// Cada loma: centro, radio inicial, paso entre curvas, cantidad y forma.
const LOMAS = [
  { cx: 860, cy: 300, r0: 40, paso: 38, n: 11, fase: 0.4 },
  { cx: 260, cy: 640, r0: 30, paso: 34, n: 8, fase: 2.1 },
];

const fmt = (n: number) => n.toFixed(1);

// Curva cerrada suave (Catmull-Rom → Bézier cúbicas) por los puntos dados.
const suave = (p: [number, number][]) => {
  const n = p.length;
  let d = `M${fmt(p[0][0])} ${fmt(p[0][1])}`;
  for (let i = 0; i < n; i++) {
    const p0 = p[(i - 1 + n) % n];
    const p1 = p[i];
    const p2 = p[(i + 1) % n];
    const p3 = p[(i + 2) % n];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${fmt(c1[0])} ${fmt(c1[1])} ${fmt(c2[0])} ${fmt(c2[1])} ${fmt(p2[0])} ${fmt(p2[1])}`;
  }
  return `${d} Z`;
};

const curvas = LOMAS.flatMap(({ cx, cy, r0, paso, n, fase }) =>
  Array.from({ length: n }, (_, k) => {
    const r = r0 + k * paso;
    // La deformación crece hacia afuera: las curvas internas son casi
    // círculos y las externas, más irregulares.
    const amp = 0.06 + k * 0.012;
    const pts = Array.from({ length: PUNTOS }, (_, i): [number, number] => {
      const t = (i / PUNTOS) * Math.PI * 2;
      const f =
        1 +
        amp * Math.sin(2 * t + fase) +
        amp * 0.6 * Math.sin(3 * t + fase * 1.7 + k * 0.15) +
        amp * 0.3 * Math.sin(5 * t + fase * 0.5);
      return [cx + Math.cos(t) * r * f * 1.25, cy + Math.sin(t) * r * f];
    });
    return suave(pts);
  }),
);
---

<svg class="vg-topo" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {curvas.map((d) => <path d={d} />)}
</svg>
