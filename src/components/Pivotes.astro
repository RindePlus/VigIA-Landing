---
// Fondo de La solución (decorativo): campos con riego por pivote vistos
// desde arriba. Cada uno es un círculo con las huellas concéntricas de las
// ruedas, el brazo del pivote y el cuadrado del lote alrededor. Habla de
// agua a tiempo, como el verde de la sección.
// Se genera al compilar, siempre igual. Vectores sin relleno; color y
// desvanecido en sections.css (.vg-fondo-linea--pivotes).
// Con scroll normal (celular, vertical) se ve otro dibujo: dos pivotes
// sobre el borde con Lo que hace VigIA, que unen las dos secciones
// (.vg-fondo-linea--pivotes-borde); el pie queda libre, hacia la frase.
// Ese dibujo va en dos copias alineadas al borde, cada una dentro de su
// sección, para quedar detrás del texto de las dos: la de Lo que hace VigIA
// (borde="fin") muestra la parte de arriba; la de La solución, el resto.

interface Props {
  /** "fin": sólo la copia del borde, para el pie de Lo que hace VigIA. */
  borde?: 'fin';
}

const { borde } = Astro.props;

const W = 1200;
const H = 800;

const fmt = (n: number) => n.toFixed(1);

// Los círculos van abajo y a la derecha, donde no hay contenido: asoman
// por el pie de la pantalla y al costado del video.
const PIVOTES = [
  { cx: 1080, cy: 300, r: 150, brazo: -0.9 },
  { cx: 1080, cy: 620, r: 150, brazo: 2.4 },
  { cx: 760, cy: 860, r: 150, brazo: 0.5 },
  { cx: 440, cy: 860, r: 150, brazo: -2.1 },
  { cx: 120, cy: 860, r: 150, brazo: 1.3 },
];

const circulo = (cx: number, cy: number, r: number) =>
  `M${fmt(cx - r)} ${fmt(cy)} A${fmt(r)} ${fmt(r)} 0 1 0 ${fmt(cx + r)} ${fmt(cy)} A${fmt(r)} ${fmt(r)} 0 1 0 ${fmt(cx - r)} ${fmt(cy)}`;

// Borde: dos pivotes grandes, cortados por los costados del celular. El
// borde entre las secciones está en y = 230 (sections.css usa la misma
// medida). El de la derecha sube hasta el texto del pie de Lo que hace
// VigIA; el de la izquierda queda abajo, en La solución.
const W_BORDE = 420;
const H_BORDE = 560;
const PIVOTES_BORDE = [
  { cx: 330, cy: 199, r: 140, brazo: 2.4 },
  { cx: -30, cy: 430, r: 140, brazo: -0.9 },
];

const pivote = ({ cx, cy, r, brazo }: (typeof PIVOTES)[number]) => {
  const d: string[] = [];
  // Borde del círculo y huellas de las ruedas, más juntas hacia afuera.
  for (const f of [1, 0.84, 0.66, 0.46, 0.24]) d.push(circulo(cx, cy, r * f));
  // Brazo del pivote, del centro al borde.
  d.push(`M${fmt(cx)} ${fmt(cy)} L${fmt(cx + Math.cos(brazo) * r)} ${fmt(cy + Math.sin(brazo) * r)}`);
  // Centro.
  d.push(circulo(cx, cy, 3));
  // El lote cuadrado que rodea al círculo (las esquinas quedan sin regar).
  const m = r + r / 15;
  d.push(`M${fmt(cx - m)} ${fmt(cy - m)} H${fmt(cx + m)} V${fmt(cy + m)} H${fmt(cx - m)} Z`);
  return d.join(' ');
};

const trazos = PIVOTES.map(pivote);
const trazosBorde = PIVOTES_BORDE.map(pivote);
---

{
  !borde && (
    <svg
      class="vg-fondo-linea vg-fondo-linea--pivotes"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      {trazos.map((d) => <path d={d} />)}
    </svg>
  )
}

<svg
  class:list={['vg-fondo-linea vg-fondo-linea--pivotes-borde', borde ? 'is-fin' : 'is-inicio']}
  viewBox={`0 0 ${W_BORDE} ${H_BORDE}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {trazosBorde.map((d) => <path d={d} />)}
</svg>
