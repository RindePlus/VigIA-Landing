---
// Frase destacada (sección B11 de landing-page-design): texto grande cuyas
// palabras pasan de un tono apagado al color pleno, de a una y en orden de
// lectura, a medida que la sección sube por la pantalla.
// - Un IntersectionObserver prende el cálculo sólo mientras la sección está
//   a la vista; el scroll se lee una vez por frame (requestAnimationFrame).
// - Sin JS o con movimiento reducido (sin la clase `vg-reveal-on` en <html>)
//   el texto se ve completo, en color pleno.
interface Props {
  /** Una entrada por renglón. */
  lineas: string[];
}

const { lineas } = Astro.props;
---

<section class="vg-tagline" data-vg-tagline>
  <div class="vg-wrap">
    <p class="vg-tagline__text">
      {
        lineas.map((linea) => (
          <span class="vg-tagline__line">
            {linea.split(' ').map((palabra) => (
              <>
                <span class="vg-tagline__word">{palabra}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </div>
</section>

<script>
  const root = document.documentElement;

  document.querySelectorAll<HTMLElement>('[data-vg-tagline]').forEach((section) => {
    if (!root.classList.contains('vg-reveal-on')) return;
    const words = [...section.querySelectorAll<HTMLElement>('.vg-tagline__word')];
    let ticking = false;
    let lit = -1;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 cuando la sección asoma por abajo (85 % de la pantalla); 1 cuando
      // su parte de arriba llegó al 35 %: para entonces se leyó toda.
      const progress = (vh * 0.85 - rect.top) / (vh * 0.5);
      const next = Math.round(Math.min(1, Math.max(0, progress)) * words.length);
      if (next === lit) return;
      lit = next;
      words.forEach((w, i) => w.classList.toggle('is-on', i < next));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        window.addEventListener('scroll', onScroll, { passive: true });
        update();
      } else {
        window.removeEventListener('scroll', onScroll);
        update();
      }
    }).observe(section);
  });
</script>
