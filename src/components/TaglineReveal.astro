---
// Frase destacada (sección B11 de landing-page-design): texto grande y fijo
// (decisión 49: ya no se ilumina palabra por palabra). Cada palabra va en
// su span porque el hilo del recorrido mide los renglones para llegar a la
// frase (JourneyThread.astro): entra por el renglón del medio, justo antes
// de "antes". Cuando el hilo llega, la sección toma la clase `is-llegada` y
// "antes" se subraya con el verde del hilo, como si la línea siguiera bajo
// la palabra.

interface Props {
  /** Una entrada por renglón. `*texto*` se resalta en verde y `_texto_` en
      rojo (los colores de la historia: a tiempo / tarde). */
  lineas: string[];
}

const { lineas } = Astro.props;

// Parte cada renglón en palabras, cada una con su tono (o ninguno).
const TONOS: Record<string, string> = { '*': 'ok', _: 'critico' };
const palabras = (linea: string) =>
  linea
    .split(/(\*[^*]+\*|_[^_]+_)/)
    .filter(Boolean)
    .flatMap((tramo) => {
      const tono = TONOS[tramo[0]] && tramo.endsWith(tramo[0]) ? TONOS[tramo[0]] : undefined;
      const texto = tono ? tramo.slice(1, -1) : tramo;
      return texto.split(' ').filter(Boolean).map((p) => ({ p, tono }));
    });
---

<section class="vg-tagline vg-pantalla" id="frase" data-vg-tagline>
  <div class="vg-wrap">
    <p class="vg-tagline__text">
      {
        lineas.map((linea) => (
          <span class="vg-tagline__line">
            {palabras(linea).map(({ p, tono }) => (
              <>
                <span class={tono ? `vg-tagline__word vg-tagline__word--${tono}` : 'vg-tagline__word'}>{p}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </div>
</section>

