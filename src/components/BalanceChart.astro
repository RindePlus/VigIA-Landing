---
// Módulo 1: gráfico ilustrativo con VigIA. Entran los datos del lote, se
// dibuja el balance hídrico, la línea cruza el umbral dentro del pronóstico y
// aparece la alerta. SVG sin JS; los colores salen de tokens (sigue al tema).
// La animación la dispara MediaStory con `.is-playing` (ver sections.css);
// sin ella se ve el estado final.
import { x, AU, UMBRAL_Y, path } from '../data/balanceEjemplo';

const HOY = 20;
const pasado = AU.filter(([d]) => d <= HOY);
const futuro = AU.filter(([d]) => d >= HOY);

// Datos que usa VigIA para calcular el día de hoy (coherentes entre sí:
// 34 °C con 40 % de humedad dan un DPV de unos 3,2 kPa).
const DATOS = ['34 °C', 'HR 40 %', 'DPV 3,2 kPa', 'Lluvia 12 mm'];
---

<figure class="vg-chart">
  <figcaption class="vg-chart__head">
    <span class="vg-chart__title">Balance hídrico · Ambiente 2</span>
    <span class="vg-chart__note">Ejemplo ilustrativo</span>
  </figcaption>

  <ul class="vg-chart__inputs" aria-label="Datos del lote">
    {DATOS.map((d, i) => <li class="vg-chart__input" style={`--d: ${i * 0.3}s`}>{d}</li>)}
  </ul>

  <svg viewBox="0 0 560 270" role="img" aria-labelledby="vg-chart-desc">
    <desc id="vg-chart-desc">
      El agua útil del suelo baja día a día. En el tramo de pronóstico cruza el
      umbral del cultivo dentro de 4 días, y ahí se genera la alerta.
    </desc>
    <defs>
      <clipPath id="vg-chart-reveal">
        <rect class="vg-chart__reveal" x="40" y="0" width="480" height="270" />
      </clipPath>
    </defs>

    <g class="vg-chart__fc">
      <rect class="vg-chart__forecast" x={x(HOY)} y="20" width={x(30) - x(HOY)} height="210" />
      <text class="vg-chart__label" x={x(HOY) + 8} y="38">Pronóstico</text>
    </g>

    <line class="vg-chart__axis" x1="40" y1="230" x2="520" y2="230" />
    <line class="vg-chart__umbral" x1="40" y1={UMBRAL_Y} x2="520" y2={UMBRAL_Y} />
    <text class="vg-chart__label vg-chart__label--umbral" x="44" y={UMBRAL_Y + 18}>Umbral del cultivo</text>
    <text class="vg-chart__label vg-chart__label--au" x="44" y="76">Agua útil</text>

    <g class="vg-chart__data" clip-path="url(#vg-chart-reveal)">
      <rect class="vg-chart__rain" x={x(7) - 5} y="208" width="10" height="22" rx="2" />
      <rect class="vg-chart__rain" x={x(8) - 5} y="196" width="10" height="34" rx="2" />
      <text class="vg-chart__label" x={x(7) - 12} y="190">Lluvia</text>
      <path class="vg-chart__au" d={path(pasado)} />
      <path class="vg-chart__au vg-chart__au--forecast" d={path(futuro)} />
      <line class="vg-chart__today" x1={x(HOY)} y1="20" x2={x(HOY)} y2="230" />
      <circle class="vg-chart__dot" cx={x(HOY)} cy="125" r="5" />
    </g>

    <text class="vg-chart__label vg-chart__label--strong" x={x(HOY) - 30} y="252">Hoy</text>
    <text class="vg-chart__label" x={x(24) - 14} y="252">+4 días</text>

    <g class="vg-chart__alertg">
      <circle class="vg-chart__alert-ring" cx={x(24)} cy={UMBRAL_Y + 2} r="13" />
      <circle class="vg-chart__alert" cx={x(24)} cy={UMBRAL_Y + 2} r="6" />
    </g>
  </svg>

  <div class="vg-alert vg-alert--alerta vg-chart__callout">
    <span class="vg-alert__chip">Alerta</span>
    <p class="vg-alert__title">Estrés hídrico moderado en 4 días</p>
    <p class="vg-alert__action">Planificar riego o bioinsumo en la ventana de hoy a 3 días.</p>
  </div>
</figure>
