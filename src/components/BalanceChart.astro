---
// Módulo 1: gráfico con VigIA, simplificado para leerse de un vistazo. Se
// dibuja el agua útil, entra el pronóstico y, justo antes de que la línea
// toque el umbral, llega la notificación "Alerta enviada" (WhatsApp y
// plataforma). SVG sin JS; los colores salen de tokens (sigue al tema).
// La animación la dispara MediaStory con `.is-playing` (ver sections.css);
// sin ella se ve el estado final, con la notificación visible.
import { PiBellRinging, PiWhatsappLogo } from 'react-icons/pi';
import { x, y, AU, BASE, UMBRAL as UMBRAL_Y, pathAlto as path } from '../data/balanceEjemplo';

const HOY = 20;
const AVISO = 24; // día en que se cruza el umbral según el pronóstico
const pasado = AU.filter(([d]) => d <= HOY);
const futuro = AU.filter(([d]) => d >= HOY);
---

<figure class="vg-chart vg-chart--hero vg-chart--alto">
  <figcaption class="vg-chart__head">
    <span class="vg-chart__title">Agua del suelo · Lote 12</span>
  </figcaption>

  <svg viewBox={`0 20 560 ${BASE + 22}`} role="img" aria-labelledby="vg-chart-desc">
    <desc id="vg-chart-desc">
      El agua útil del suelo baja día a día. El pronóstico muestra que va a
      cruzar el umbral del cultivo en 4 días, y VigIA envía la alerta antes.
    </desc>
    <defs>
      <clipPath id="vg-chart-reveal">
        <rect class="vg-chart__reveal" x="40" y="0" width="480" height={BASE + 30} />
      </clipPath>
    </defs>

    <g class="vg-chart__fc">
      <rect class="vg-chart__forecast" x={x(HOY)} y="20" width={x(30) - x(HOY)} height={BASE - 20} />
      <text class="vg-chart__label" x={(x(HOY) + x(30)) / 2} y={BASE - 12} text-anchor="middle">Pronóstico</text>
    </g>

    <line class="vg-chart__axis" x1="40" y1={BASE} x2="520" y2={BASE} />
    <line class="vg-chart__umbral" x1="40" y1={UMBRAL_Y} x2="520" y2={UMBRAL_Y} />
    <text class="vg-chart__label vg-chart__label--umbral" x="44" y={UMBRAL_Y + 32}>Umbral del cultivo</text>
    <text class="vg-chart__label vg-chart__label--au" x="44" y={y(70)}>Agua útil</text>

    <g class="vg-chart__data" clip-path="url(#vg-chart-reveal)">
      <path class="vg-chart__au" d={path(pasado)} />
      <path class="vg-chart__au vg-chart__au--forecast" d={path(futuro)} />
      <line class="vg-chart__today" x1={x(HOY)} y1="20" x2={x(HOY)} y2={BASE} />
      <circle class="vg-chart__dot" cx={x(HOY)} cy={y(125)} r="5" />
    </g>

    <text class="vg-chart__label vg-chart__label--strong" x={x(HOY)} y={BASE + 32} text-anchor="middle">Hoy</text>

    <g class="vg-chart__alertg">
      <circle class="vg-chart__alert-ring" cx={x(AVISO)} cy={y(150)} r="13" />
      <circle class="vg-chart__alert" cx={x(AVISO)} cy={y(150)} r="6" />
    </g>
  </svg>

  <!-- Notificación: llega justo antes de que la línea toque el umbral. -->
  <div class="vg-chart__toast">
    <span class="vg-chart__toast-icon" aria-hidden="true"><PiBellRinging /></span>
    <span class="vg-chart__toast-text">
      <strong>Alerta enviada</strong>
      <span>Estrés hídrico en 4 días</span>
    </span>
    <PiWhatsappLogo className="vg-chart__toast-wa" aria-label="Por WhatsApp" />
  </div>
</figure>
